.tabbar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  z-index: 999;
  display: flex;
  height: calc(100rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  background: var(--c-tabbar-bg, #FFFFFF);
  border-top: 1rpx solid var(--c-border, #F0F1F4);
}
.tb-bg {
  position: absolute;
  left: 0; top: 0; width: 100%; height: 100%;
}
.tb-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
}
.tb-icon {
  width: 52rpx;
  height: 52rpx;
}
.tb-text {
  font-size: 22rpx;
  line-height: 1.4;
  margin-top: 2rpx;
  font-family: var(--font-ui);
}
