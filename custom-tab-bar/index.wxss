.tabbar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  justify-content: space-around;
  padding: 14rpx 18rpx calc(12rpx + env(safe-area-inset-bottom));
  background: var(--card, #fff);
  border-top: 1rpx solid var(--line, #e3eae6);
  z-index: 50;
}
.tab {
  background: transparent;
  color: var(--muted, #70817b);
  font-size: 22rpx;
  display: flex;
  align-items: center;
  flex-direction: column;
  gap: 6rpx;
  line-height: 1.4;
  padding: 0 22rpx;
  margin: 0;
  border-radius: 0;
}
.tab::after {
  border: 0;
}
.tab-icon {
  padding: 7rpx 28rpx;
  border-radius: 22rpx;
}
.selected {
  color: var(--primary, #416c64);
  font-weight: 600;
}
.selected .tab-icon {
  background: var(--soft, #e9f1ed);
}
