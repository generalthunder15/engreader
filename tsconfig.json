{
  "compilerOptions": {
    "target": "ES2019",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": ".",
    "types": ["miniprogram-api-typings"],
    "lib": ["ES2020"],
    "noEmitOnError": true
  },
  "include": [
    "app.ts",
    "core/**/*.ts",
    "services/**/*.ts",
    "pages/**/*.ts",
    "components/**/*.ts",
    "custom-tab-bar/**/*.ts",
    "data/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "tests", "tools"]
}
