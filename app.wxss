page {
  background: #f5f7f5;
  color: #203530;
  font-size: 28rpx;
  font-family: -apple-system, "PingFang SC", sans-serif;
  --bg: #f5f7f5;
  --card: #fff;
  --text: #203530;
  --muted: #70817b;
  --line: #e3eae6;
  --primary: #416c64;
  --soft: #e9f1ed;
  --danger: #b95046;
  --on-primary: #fff;
}
view,
text,
button,
input,
textarea {
  box-sizing: border-box;
}
button {
  font-size: 27rpx;
  line-height: 1.45;
  margin: 0;
  border-radius: 20rpx;
  padding: 23rpx 28rpx;
  background: var(--soft);
  color: var(--primary);
  font-weight: 600;
}
button::after {
  border: 0;
}
button[disabled] {
  opacity: 0.45;
  color: var(--muted);
}
button.primary,
.primary {
  background: var(--primary);
  color: var(--on-primary);
}
button.ghost {
  background: transparent;
  color: var(--muted);
}
button.small {
  padding: 15rpx 22rpx;
  font-size: 24rpx;
  border-radius: 14rpx;
}
button.danger,
.danger {
  color: var(--danger);
}
.page {
  min-height: 100vh;
  background: var(--bg);
  color: var(--text);
  font-family: var(--font-ui);
  padding: 32rpx 36rpx 64rpx;
}
.tab-page {
  padding-bottom: calc(190rpx + env(safe-area-inset-bottom));
}
.eyebrow {
  font-size: 21rpx;
  letter-spacing: 4rpx;
  color: var(--primary);
  font-weight: 600;
  margin-bottom: 14rpx;
}
.heading {
  font-size: 50rpx;
  font-weight: 650;
  letter-spacing: -1rpx;
  line-height: 1.3;
}
.sub {
  color: var(--muted);
  font-size: 25rpx;
  line-height: 1.7;
  margin-top: 14rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin: 36rpx 0 20rpx;
}
.card {
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 26rpx;
  padding: 28rpx;
  margin: 22rpx 0;
}
.hero {
  padding: 38rpx 32rpx;
  background: var(--soft);
  border-radius: 30rpx;
  margin: 26rpx 0;
}
.row {
  display: flex;
  align-items: center;
  gap: 18rpx;
}
.between {
  justify-content: space-between;
}
.grow {
  flex: 1;
  min-width: 0;
}
.stack {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.wrap {
  flex-wrap: wrap;
}
.muted {
  color: var(--muted);
}
.label {
  font-size: 25rpx;
  color: var(--muted);
  margin: 26rpx 0 12rpx;
}
.badge {
  display: inline-block;
  padding: 7rpx 15rpx;
  border-radius: 12rpx;
  background: var(--soft);
  color: var(--primary);
  font-size: 21rpx;
}
.divider {
  height: 1rpx;
  background: var(--line);
  margin: 24rpx 0;
}
.empty {
  padding: 90rpx 20rpx;
  text-align: center;
  line-height: 1.8;
}
.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-top: 24rpx;
}
.empty .sub {
  margin: 12rpx auto 32rpx;
  max-width: 480rpx;
}
.empty button {
  display: inline-block;
}
.field {
  width: 100%;
  background: var(--bg);
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  padding: 22rpx;
  color: var(--text);
  font-size: 27rpx;
  min-height: 86rpx;
}
.textarea {
  width: 100%;
  height: 240rpx;
  line-height: 1.7;
}
.field-placeholder {
  color: var(--muted);
}
.chips {
  display: flex;
  gap: 14rpx;
  flex-wrap: wrap;
}
.chip {
  padding: 14rpx 22rpx;
  background: var(--bg);
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  font-size: 24rpx;
}
.chip.active {
  background: var(--soft);
  border-color: var(--primary);
  color: var(--primary);
}
.icon-button {
  width: 76rpx;
  height: 76rpx;
  padding: 0;
  display: flex;
  justify-content: center;
  align-items: center;
  background: transparent;
  flex-shrink: 0;
}
.progress {
  height: 8rpx;
  background: var(--line);
  border-radius: 20rpx;
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  background: var(--primary);
  border-radius: 20rpx;
  transition: width 0.2s;
}
.error {
  padding: 22rpx;
  border-radius: 18rpx;
  background: var(--soft);
  color: var(--danger);
  font-size: 25rpx;
  line-height: 1.7;
  margin: 20rpx 0;
}
.loading {
  padding: 30rpx;
  text-align: center;
  color: var(--muted);
}
.sticky-actions {
  position: sticky;
  bottom: 24rpx;
  display: flex;
  gap: 16rpx;
  background: var(--bg);
  padding-top: 18rpx;
}
.sticky-actions button {
  flex: 1;
}
.mask {
  position: fixed;
  inset: 0;
  background: rgba(10, 24, 18, 0.42);
  z-index: 90;
}
.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 91;
  background: var(--card);
  border-radius: 32rpx 32rpx 0 0;
  padding: 24rpx 32rpx calc(28rpx + env(safe-area-inset-bottom));
  max-height: 88vh;
  box-shadow: 0 -8rpx 40rpx rgba(0, 0, 0, 0.08);
}
.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
  font-size: 30rpx;
  font-weight: 600;
}
.sheet-scroll {
  max-height: 65vh;
  height: 60vh;
}
.quote {
  font-family: var(--font-read, Georgia, serif);
  font-size: 32rpx;
  line-height: 1.8;
  background: var(--soft);
  border-radius: 18rpx;
  padding: 22rpx;
}
.body-text {
  line-height: 1.9;
  white-space: pre-wrap;
}
.list-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.list-row:last-child {
  border-bottom: 0;
}
.menu-title {
  font-size: 28rpx;
  font-weight: 500;
}
.count {
  font-size: 52rpx;
  font-weight: 600;
  color: var(--primary);
}
.caption {
  font-size: 22rpx;
  color: var(--muted);
  line-height: 1.6;
}
.full {
  width: 100%;
}
.spacer {
  height: 24rpx;
}

/* Shared underline tabs; ordinary action chips retain their button appearance. */
.panel-tabs .chip,
.appearance-options .chip,
.editor-types button {
  position: relative;
  background: transparent;
  border: 0;
  border-radius: 0;
  color: var(--muted);
  box-shadow: none;
}
.panel-tabs .chip.active,
.appearance-options .chip.active,
.editor-types button.primary {
  background: transparent;
  color: var(--primary);
  font-weight: 600;
}
.panel-tabs .chip::after,
.appearance-options .chip::after,
.editor-types button::after {
  content: "";
  position: absolute;
  top: auto;
  bottom: 0;
  left: 20%;
  right: 20%;
  width: auto;
  height: 4rpx;
  border: 0;
  border-radius: 4rpx;
  transform: none;
  background: transparent;
}
.panel-tabs .chip.active::after,
.appearance-options .chip.active::after,
.editor-types button.primary::after {
  background: var(--primary);
}
