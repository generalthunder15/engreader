  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@xmldom/xmldom": "^0.9.12",
    "miniprogram-api-typings": "^4.0.0",
    "prettier": "^3.9.8",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0"
  }
}
