.page { min-height: 100vh; background: var(--c-bg); position: relative; }
.theme-bg { position: fixed; left: 0; top: 0; width: 100vw; height: 100vh; z-index: 0; }
.page-body { position: relative; z-index: 1; padding: 24rpx 30rpx calc(60rpx + env(safe-area-inset-bottom)); }

.empty { padding: 180rpx 0; text-align: center; }
.empty-icon { font-size: 90rpx; }
.empty-text { margin-top: 24rpx; font-size: 32rpx; color: var(--c-text-sub); font-weight: 600; }
.empty-hint { margin-top: 12rpx; font-size: 24rpx; color: var(--c-text-hint); }

.f-item {
  background: var(--c-card); border-radius: var(--r-card);
  padding: 28rpx; margin-bottom: 20rpx;
}
.f-title { font-size: 30rpx; font-weight: 600; color: var(--c-text); }
.f-book { font-size: 24rpx; color: var(--c-text-hint); margin-top: 8rpx; }
