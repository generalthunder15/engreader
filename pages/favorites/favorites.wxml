<view class="page" style="{{themeStyle}}">
  <view class="eyebrow">BACK TO YOUR FAVORITES</view>
  <view class="heading">值得再读</view>
  <view class="sub">收藏的 {{items.length}} 个章节，随时回来看看。</view>
  <view class="card" wx:for="{{items}}" wx:key="id">
    <view
      class="row"
      bindtap="open"
      data-book="{{item.bookId}}"
      data-chapter="{{item.chapterId}}"
    >
      <app-icon name="bookmark" size="52" />
      <view class="grow">
        <view class="menu-title">{{item.title}}</view>
        <view class="sub">{{item.bookTitle}}</view>
      </view>
      <app-icon name="arrow" size="30" />
    </view>
    <button class="small ghost remove" bindtap="remove" data-id="{{item.id}}">
      取消收藏
    </button>
  </view>
  <view class="empty" wx:if="{{!items.length}}">
    <app-icon name="bookmark" size="88" />
    <view class="empty-title">还没有收藏章节</view>
    <view class="sub">在阅读器中点亮书签，把好文章留住。</view>
  </view>
</view>

<app-dialog id="app-dialog" style="{{themeStyle}}" />
