<view class="page" style="{{themeStyle}}">
  <view class="eyebrow">WORDS TO KEEP</view>
  <view class="heading">我的生词本</view>
  <view class="sub">已积累 {{total}} 个词，每一个都值得记住。</view>
  <view class="row search-row">
    <app-icon name="search" size="36" />
    <input
      class="grow"
      value="{{query}}"
      bindinput="search"
      placeholder="搜索英文或释义"
    />
  </view>
  <button class="primary" wx:if="{{total}}" bindtap="quiz">
    用这些词练一练
  </button>
  <view class="card" wx:for="{{items}}" wx:key="word">
    <view class="row between">
      <view class="word grow">{{item.word}}</view>
      <button
        class="icon-button"
        bindtap="speak"
        data-word="{{item.word}}"
        aria-label="朗读"
      >
        <app-icon name="volume" size="36" />
      </button>
    </view>
    <view class="caption">{{item.phonetic}}</view>
    <view class="meaning">
      {{item.translation || item.meaning || '暂未补充释义'}}
    </view>
    <view class="row between">
      <view class="caption grow">{{item.fromBook}} {{item.fromChapter}}</view>
      <button class="small ghost" bindtap="remove" data-word="{{item.word}}">
        移除
      </button>
    </view>
  </view>
  <view class="empty" wx:if="{{!items.length}}">
    <app-icon name="book" size="86" />
    <view class="empty-title">
      {{query ? '没有找到匹配的词' : '在阅读中收集你的词汇'}}
    </view>
    <view class="sub">
      {{query ? '试试其他关键词。' : '双击单词，查词后加入生词本。'}}
    </view>
  </view>
</view>
