@import "../../components/word-text/selection.wxss";
.task {
  padding: 24rpx 0;
  border-top: 1rpx solid var(--line);
  margin-top: 22rpx;
}
.task-actions {
  justify-content: flex-end;
  margin-top: 18rpx;
}
.bubble {
  padding: 26rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  margin: 24rpx 30rpx 24rpx 0;
}
.bubble.mine {
  margin-left: 60rpx;
  margin-right: 0;
  background: var(--soft);
  border: 0;
}
.bubble .caption {
  margin-bottom: 12rpx;
}
.question {
  margin-top: 24rpx;
}
.answer-options {
  display: flex;
  flex-wrap: nowrap;
  gap: 16rpx;
  margin-top: 18rpx;
}
.answer-options .question-option {
  flex: 1;
  width: 0;
  min-width: 0;
  margin: 0;
  padding: 20rpx 0;
  text-align: center;
  font-weight: 600;
}
.composer {
  display: flex;
  align-items: center;
  gap: 14rpx;
  position: sticky;
  bottom: calc(135rpx + env(safe-area-inset-bottom));
  background: var(--bg);
  padding: 20rpx 0;
}
.composer input {
  min-width: 0;
}
.session-switch {
  padding: 20rpx 0;
  text-align: right;
  color: var(--primary);
  font-size: 25rpx;
}
.lesson-actions {
  margin: 24rpx 0;
  gap: 12rpx;
}
.lesson-actions button {
  flex: 1;
  width: 0;
  min-width: 0;
  margin: 0;
  padding: 20rpx 8rpx;
}
.chat-compose {
  margin-top: 28rpx;
}
.chat-compose button {
  margin-top: 14rpx;
}

.question-option.chosen { background: var(--primary); color: var(--on-primary); }
.answer-options { margin-bottom: 20rpx; }
