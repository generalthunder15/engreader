.task {
  padding: 24rpx 0;
  border-top: 1rpx solid var(--line);
  margin-top: 22rpx;
}
.task-actions {
  justify-content: flex-end;
  margin-top: 18rpx;
}
.bubble {
  padding: 26rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  margin: 24rpx 30rpx 24rpx 0;
}
.bubble.mine {
  margin-left: 60rpx;
  margin-right: 0;
  background: var(--soft);
  border: 0;
}
.bubble .caption {
  margin-bottom: 12rpx;
}
.question {
  margin-top: 24rpx;
}
.question-title {
  line-height: 1.8;
  font-size: 29rpx;
}
.question-option {
  display: block;
  width: 100%;
  margin-top: 14rpx;
  text-align: left;
  font-weight: 400;
  padding: 20rpx;
}
.composer {
  display: flex;
  align-items: center;
  gap: 14rpx;
  position: sticky;
  bottom: calc(135rpx + env(safe-area-inset-bottom));
  background: var(--bg);
  padding: 20rpx 0;
}
.composer input {
  min-width: 0;
}
