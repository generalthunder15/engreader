@import "../../components/word-text/selection.wxss";
.task {
  padding: 24rpx 0;
  border-top: 1rpx solid var(--line);
  margin-top: 22rpx;
}
.task-actions {
  justify-content: flex-end;
  margin-top: 18rpx;
}
.bubble {
  padding: 26rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  margin: 24rpx 30rpx 24rpx 0;
}
.bubble.mine {
  margin-left: 60rpx;
  margin-right: 0;
  background: var(--soft);
  border: 0;
}
.bubble .caption {
  margin-bottom: 12rpx;
}
.question {
  margin-top: 24rpx;
}
.answer-options {
  display: flex;
  flex-wrap: nowrap;
  gap: 16rpx;
  margin-top: 18rpx;
}
.answer-options .question-option {
  flex: 1;
  width: 0;
  min-width: 0;
  margin: 0;
  padding: 20rpx 0;
  text-align: center;
  font-weight: 600;
}
.composer {
  display: flex;
  align-items: center;
  gap: 14rpx;
  position: sticky;
  bottom: calc(135rpx + env(safe-area-inset-bottom));
  background: var(--bg);
  padding: 20rpx 0;
}
.composer input {
  min-width: 0;
}
.session-switch {
  padding: 20rpx 0;
  text-align: right;
  color: var(--primary);
  font-size: 25rpx;
}
.lesson-actions {
  margin: 24rpx 0;
  gap: 12rpx;
}
.lesson-actions button {
  flex: 1;
  width: 0;
  min-width: 0;
  margin: 0;
  padding: 20rpx 8rpx;
}
.chat-compose {
  margin-top: 28rpx;
}
.chat-compose button {
  margin-top: 14rpx;
}

.question-option.chosen { background: var(--primary); color: var(--on-primary); }
.answer-options { margin-bottom: 20rpx; }

.sidebar-mask { position: fixed; inset: 0; z-index: 120; background: rgba(0,0,0,.3); }
.study-sidebar { position: fixed; left: 0; top: 0; bottom: 0; width: 84vw; max-width: 620rpx; z-index: 121; background: var(--card); padding: 28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom)); display: flex; flex-direction: column; box-sizing: border-box; box-shadow: 8rpx 0 36rpx rgba(0,0,0,.1); }
.sidebar-header { display: flex; align-items: center; justify-content: space-between; font-size: 34rpx; font-weight: 600; margin-bottom: 28rpx; }
.sidebar-header .icon-button { width: 60rpx; height: 60rpx; margin: 0; padding: 0; flex: 0 0 60rpx; }
.sidebar-new { width: 100%; margin: 0; }
.sidebar-hint { margin-top: 18rpx; line-height: 1.65; }
.sidebar-label { color: var(--muted); font-size: 25rpx; margin: 34rpx 0 16rpx; }
.sidebar-history { flex: 1; height: 0; min-height: 0; }
.sidebar-session { padding: 22rpx 18rpx; margin-bottom: 10rpx; border-radius: 16rpx; }
.current-session { background: var(--soft); color: var(--primary); }
.sidebar-title { font-size: 28rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-bottom: 8rpx; }

.study-sidebar { top: 16rpx; bottom: 16rpx; left: 16rpx; border-radius: 36rpx; overflow: hidden; }
.sidebar-header .icon-button { margin-left: auto; background: var(--soft); border-radius: 50%; }
.sidebar-session { border-radius: 24rpx; margin-bottom: 16rpx; padding: 24rpx 20rpx; }



.page.tab-page { padding-top: 0; }
.study-header { position: fixed; top: 0; left: 0; right: 0; z-index: 75; background: var(--bg); border-radius: 0 0 28rpx 28rpx; box-shadow: 0 4rpx 18rpx rgba(0,0,0,.05); }
.study-nav { display: flex; align-items: center; justify-content: flex-start; gap: 14rpx; padding-left: 24rpx; box-sizing: border-box; }
.study-menu-button { flex: 0 0 64rpx; width: 64rpx; height: 64rpx; margin: 0; padding: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 7rpx; background: var(--soft); border-radius: 50%; }
.study-menu-button view { width: 28rpx; height: 3rpx; background: var(--primary); border-radius: 3rpx; }
.study-nav-title { flex: 0 1 auto; min-width: 0; margin: 0; text-align: left; font-size: 30rpx; font-weight: 600; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.study-progress { width: 100%; height: 84rpx; white-space: nowrap; }
.progress-chain { display: inline-flex; align-items: center; height: 84rpx; padding: 0 24rpx; gap: 12rpx; }
.progress-node { display: inline-flex; align-items: center; gap: 7rpx; color: var(--muted); font-size: 21rpx; }
.step-dot { display: inline-flex; align-items: center; justify-content: center; width: 28rpx; height: 28rpx; border: 1rpx solid var(--line); border-radius: 50%; font-size: 18rpx; }
.progress-node.done, .step-link.done { color: var(--primary); }
.progress-node.done .step-dot { background: var(--primary); border-color: var(--primary); color: var(--on-primary); }
.progress-node.current { color: var(--primary); font-weight: 600; }
.progress-node.current .step-dot { border: 2rpx solid var(--primary); background: var(--soft); }
.step-link { color: var(--line); font-size: 22rpx; }

.question-material { margin-bottom: 22rpx; padding: 20rpx; border-radius: 20rpx; background: var(--soft); }
