<view class="page tab-page" style="{{themeStyle}}">
  <view class="study-header" style="padding-top:{{navTop}}px">
    <view class="study-nav" style="height:{{navHeight}}px;padding-right:{{navRight}}px">
      <view class="study-menu-button" aria-role="button" aria-label="打开历史对话" bindtap="openSidebar"><view></view><view></view><view></view></view>
      <text class="study-nav-title">{{headerTitle}}</text>
    </view>
    <scroll-view wx:if="{{steps.length}}" scroll-x class="study-progress" show-scrollbar="{{false}}">
      <view class="progress-chain">
        <block wx:for="{{steps}}" wx:key="label">
          <view class="progress-node {{item.status}}"><text class="step-dot">{{item.status === 'done' ? '✓' : index + 1}}</text><text>{{item.label}}</text></view>
          <text wx:if="{{index < steps.length - 1}}" class="step-link {{item.status === 'done' ? 'done' : ''}}">→</text>
        </block>
      </view>
    </scroll-view>
  </view>
  <view style="height:calc({{navTop + navHeight}}px + {{steps.length ? 84 : 0}}rpx)"></view>
  <block wx:if="{{sidebarOpen}}">
    <view class="sidebar-mask" bindtap="closeSidebar" catchtouchmove="stopSidebarTouch"></view>
    <view class="study-sidebar" style="top:{{navTop + navHeight}}px" catchtouchmove="stopSidebarTouch">
      <view class="sidebar-header"><text>学习对话</text><button class="icon-button" bindtap="closeSidebar" aria-label="关闭历史对话"><app-icon name="close" size="34" /></button></view>
      <button wx:if="{{!hasAssessment}}" class="primary sidebar-new" bindtap="start">先认识一下你</button>
      <button wx:else class="primary sidebar-new" bindtap="newLesson" disabled="{{!canNew || busy}}">＋ 开启新一课</button>
      <view wx:if="{{hasAssessment && !canNew}}" class="caption sidebar-hint">完成测评或当前课程的全部错题复测后，才能开启下一课。</view>
      <view class="sidebar-label">历史对话</view>
      <scroll-view scroll-y class="sidebar-history">
        <view wx:for="{{sessions}}" wx:key="id" class="sidebar-session {{current.id === item.id ? 'current-session' : ''}}" data-index="{{index}}" bindtap="select" aria-role="button">
          <view class="sidebar-title">{{item.title}}</view><view class="caption">{{item.label}}</view>
        </view>
        <view wx:if="{{!sessions.length}}" class="sub">还没有学习记录</view>
      </scroll-view>
      <view wx:if="{{busy}}" class="caption">教练正在处理，完成后可切换对话。</view>
    </view>
  </block>
  <block wx:if="{{!current}}">
  <view class="eyebrow">ONE LESSON AT A TIME</view>
  <view class="heading">与你一起，循序渐进</view>
  <view class="sub">一篇文章，一次深入学习。每三课，温习一次。</view>
  </block>
  <block wx:if="{{current}}">
    <view class="card">
      <view class="menu-title">{{current.title}}</view>
      <view class="sub">{{label}}</view>
      <view wx:if="{{current.phase === 'assessment'}}" class="caption">
        已完成 {{current.assessed}} / 24 题
      </view>
      <view wx:if="{{current.phase === 'remediation'}}" class="caption">
        还有 {{remaining}} 个知识点需要通过新题复测
      </view>
      <view wx:if="{{current.phase === 'intro'}}" class="sub">
        介绍一下你的英语基础、学习目标、薄弱项和每天可用的时间。按自己的方式说就好。
      </view>
      <view
        wx:if="{{current.kind === 'lesson' && current.phase !== 'generating'}}"
        class="row lesson-actions"
      >
        <button class="small" bindtap="read">阅读文章</button>
        <button
          wx:if="{{current.phase === 'reading'}}"
          class="small"
          bindtap="quiz"
        >
          单词闯关
        </button>
        <button
          wx:if="{{current.generationStep === 21 && current.phase !== 'reading'}}"
          class="small"
          bindtap="exam"
        >
          {{current.submitted ? '查看试卷' : '开始答卷'}}
        </button>
      </view>
    </view>
    <view wx:if="{{current.messages.length}}" class="history-status">
      {{loadingHistory ? '正在加载…' : hasOlder ? '下拉查看更早的对话' : '已显示全部对话'}}
    </view>
    <view
      wx:for="{{current.messages}}"
      wx:key="id"
      class="bubble {{item.role === 'user' ? 'mine' : ''}}"
    >
      <view class="caption">{{item.role === 'user' ? '我' : '学习教练'}}</view>
      <view wx:if="{{item.content}}" class="{{item.notice ? 'caption' : 'body-text'}}"><word-text text="{{item.content}}" data-source="{{item.id + '-' + 'body'}}" selected-index="{{wordSource === (item.id + '-' + 'body') ? wordIndex : -1}}" bind:word="selectWord" /></view>
      <view wx:if="{{item.question}}" class="question">
        <view wx:if="{{item.question.material}}" class="body-text question-material"><word-text text="{{item.question.material}}" data-source="{{item.id + '-' + 'material'}}" selected-index="{{wordSource === (item.id + '-' + 'material') ? wordIndex : -1}}" bind:word="selectWord" /></view>
        <view class="body-text"><word-text text="{{item.question.title}}" data-source="{{item.id + '-' + 'title'}}" selected-index="{{wordSource === (item.id + '-' + 'title') ? wordIndex : -1}}" bind:word="selectWord" /></view>
        <view
          wx:for="{{item.question.options}}"
          wx:key="index"
          wx:for-item="option"
          class="sub"
        >
          <word-text text="{{option}}" data-source="{{item.id + '-' + 'option-' + index}}" selected-index="{{wordSource === (item.id + '-' + 'option-' + index) ? wordIndex : -1}}" bind:word="selectWord" />
        </view>
      </view>
    </view>
    <view wx:if="{{current.pending && !readonly}}" class="card">
      <view class="caption">回答当前题目</view>
      <view wx:if="{{current.pending.type === 'choice'}}" class="answer-options">
        <button
          wx:for="{{current.pending.options}}"
          wx:key="index"
          class="question-option {{selectedOption === (index === 0 ? 'A' : index === 1 ? 'B' : index === 2 ? 'C' : 'D') ? 'chosen' : ''}}"
          data-option="{{index === 0 ? 'A' : index === 1 ? 'B' : index === 2 ? 'C' : 'D'}}"
          bindtap="chooseOption"
          disabled="{{busy}}"
        >
          {{index === 0 ? 'A' : index === 1 ? 'B' : index === 2 ? 'C' : 'D'}}
        </button>
      </view>
      <block>
        <textarea
          class="field textarea"
          value="{{answer}}"
          bindinput="answer"
          placeholder="{{current.pending.type === 'choice' ? '补充思路、疑问或后续出题要求（选填）…' : '在这里填写答案…'}}"
          maxlength="5000"
          show-confirm-bar="{{false}}"
          disabled="{{busy}}"
        />
        <button
          class="primary full"
          bindtap="answerQuestion"
          disabled="{{busy || (current.pending.type === 'choice' ? !selectedOption : !answer)}}"
        >
          确认发送
        </button>
      </block>
    </view>
    <view wx:if="{{busy}}" class="loading">
      {{progress || '教练正在思考…'}}
    </view>
    <view wx:if="{{error}}" class="error">{{error}}</view>
    <button
      wx:if="{{!readonly && current.phase !== 'intro' && current.phase !== 'exam' && !current.pending}}"
      class="full"
      bindtap="advance"
      disabled="{{busy}}"
    >
      {{current.phase === 'generating' || current.phase === 'exam-generating' ? '继续生成 / 重试' : current.phase === 'grading' ? '批改试卷 / 重试' : current.phase === 'reading' ? '已完成闯关，解锁题目' : '继续学习 / 重试'}}
    </button>
    <view
      wx:if="{{current.phase === 'intro'}}"
      class="chat-compose"
    >
      <textarea
        class="field textarea"
        value="{{text}}"
        bindinput="text"
        placeholder="{{current.phase === 'intro' ? '我的英语基础和目标是…' : '可以聊聊文章，或提出你的疑问…'}}"
        maxlength="5000"
        show-confirm-bar="{{false}}"
        disabled="{{busy}}"
      />
      <button class="primary full" bindtap="send" disabled="{{busy || !text}}">
        {{current.phase === 'intro' ? '介绍好了，开始测评' : '发送'}}
      </button>
    </view>
    <view wx:if="{{memoryPending}}" class="card"><view class="sub">{{memoryError || '对话已结束，等待更新归档记忆。'}}</view><button bindtap="retryMemory" disabled="{{busy}}">更新归档记忆 / 重试</button></view>
    <view wx:if="{{readonly}}" class="sub">
      这段对话已归档，可以随时回来查看。
    </view>
  </block>
  <view wx:if="{{selectedWord && !wordPanel}}" class="selection-bar {{wordMenuSide}}" style="{{wordMenuStyle}}">
    <view class="selection-arrow" style="left:{{wordArrow}}px"></view>
    <view class="selection-actions">
      <view class="selection-action" aria-role="button" hover-class="selection-action-hover" bindtap="translateWord"><app-icon name="translate" size="34" /><text>翻译</text></view>
      <view class="selection-action" aria-role="button" hover-class="selection-action-hover" data-tab="detail" bindtap="wordTab"><app-icon name="book" size="34" /><text>拆解</text></view>
      <view class="selection-action" aria-role="button" hover-class="selection-action-hover" data-tab="ask" bindtap="wordTab"><app-icon name="chat" size="34" /><text>提问</text></view>
      <view class="selection-action" aria-role="button" hover-class="selection-action-hover" bindtap="closeWord"><app-icon name="close" size="34" /><text>取消</text></view>
    </view>
  </view>
  <block wx:if="{{wordPanel}}">
    <view class="mask" bindtap="closeWord"></view>
    <view class="sheet analysis-sheet">
      <view class="sheet-head">
        <view class="chips panel-tabs">
          <view class="chip {{wordTab === 'translation' ? 'active' : ''}}" data-tab="translation" bindtap="wordTab">释义</view>
          <view class="chip {{wordTab === 'detail' ? 'active' : ''}}" data-tab="detail" bindtap="wordTab">拆解</view>
          <view class="chip {{wordTab === 'ask' ? 'active' : ''}}" data-tab="ask" bindtap="wordTab">提问</view>
        </view>
        <button class="icon-button" bindtap="closeWord" aria-label="关闭翻译面板"><app-icon name="close" size="32" /></button>
      </view>
      <scroll-view scroll-y class="sheet-scroll">
        <view class="quote">{{selectedWord}}</view>
        <view wx:if="{{wordBusy}}" class="loading">正在分析，请稍候…</view>
        <view wx:if="{{wordError}}" class="error">{{wordError}}</view>
        <block wx:if="{{wordTab === 'translation'}}">
        <view wx:if="{{wordDefinition}}">
          <view class="definition">{{wordDefinition.translation}}</view>
          <view class="caption">{{wordDefinition.phonetic}} {{wordDefinition.pos}}</view>
          <view class="badge" wx:if="{{wordDefinition.source === 'offline'}}">内置离线释义</view>
          <view class="sub" wx:for="{{wordDefinition.senses}}" wx:key="index">{{item}}</view>
          <view wx:if="{{wordDefinition.example}}" class="card"><text class="body-text">{{wordDefinition.example}}</text><view class="caption">{{wordDefinition.exampleTranslation}}</view></view>
        </view>
        <view class="row wrap panel-actions">
          <button class="small" bindtap="playWord">{{wordPlaying ? '停止朗读' : '朗读'}}</button>
          <button wx:if="{{wordDefinition}}" class="small" disabled>已加入生词本</button>
          <button wx:if="{{wordError}}" class="small" bindtap="translateWord" disabled="{{wordBusy}}">重试</button>
        </view>
        </block>
        <block wx:elif="{{wordTab === 'detail'}}">
          <block wx:if="{{wordDetail}}">
            <view class="definition">{{wordDetail.translation}}</view>
            <view class="sub">{{wordDetail.structure}}</view>
            <view class="section-title">词根与词缀</view><view class="body-text">{{wordDetail.roots}}</view>
            <view class="section-title">词形变化</view>
            <view wx:for="{{wordDetail.words}}" wx:key="index" class="card"><view>{{item.word}} · {{item.meaning}}</view><view class="sub">{{item.note}}</view></view>
            <view class="section-title">短语与搭配</view>
            <view wx:for="{{wordDetail.phrases}}" wx:key="index" class="card"><view>{{item.text}}</view><view class="sub">{{item.meaning}}</view><view class="caption">{{item.usage}}</view></view>
            <view wx:if="{{wordDetail.confusions.length}}" class="section-title">易混词辨析</view>
            <view wx:for="{{wordDetail.confusions}}" wx:key="index" class="card"><view>{{item.word}}</view><view class="sub">{{item.difference}}</view><view class="quote" wx:if="{{item.example}}">{{item.example}}</view></view>
            <view class="section-title">记忆方法</view><view class="body-text">{{wordDetail.memory}}</view><view class="sub">{{wordDetail.summary}}</view>
          </block>
          <button wx:if="{{wordError}}" data-tab="detail" bindtap="wordTab" disabled="{{wordBusy}}">重试</button>
        </block>
        <block wx:elif="{{wordTab === 'ask'}}">
          <textarea class="field textarea" value="{{wordQuestion}}" bindinput="wordQuestionInput" placeholder="针对这个单词写下你的问题…" maxlength="1000" show-confirm-bar="{{false}}" />
          <button class="primary full" bindtap="askWord" disabled="{{wordBusy || !wordQuestion}}">向 AI 提问</button>
          <view wx:if="{{wordAnswer}}" class="body-text sub"><text>{{wordAnswer}}</text></view>
        </block>
      </scroll-view>
    </view>
  </block>
</view>

<app-dialog id="app-dialog" style="{{themeStyle}}" />
