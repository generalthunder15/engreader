<view class="page tab-page" style="{{themeStyle}}">
  <view class="row between">
    <view>
      <view class="eyebrow">YOUR PERSONAL COACH</view>
      <view class="heading">一起，读得更好</view>
    </view>
    <button
      wx:if="{{state.phase !== 'idle'}}"
      class="small ghost"
      bindtap="reset"
    >
      重置
    </button>
  </view>
  <view class="sub">从你的水平出发，找到适合的阅读节奏。</view>
  <view class="hero" wx:if="{{state.phase === 'idle'}}">
    <app-icon name="chat" size="78" />
    <view class="section-title">先认识一下你的英语</view>
    <view class="sub">
      24 道小测，了解词汇、语法与阅读能力。
      <text>{{"\n"}}</text>
      完成后，为你安排书架里的阅读计划。
    </view>
    <view class="spacer"></view>
    <button class="primary" bindtap="start" disabled="{{sending}}">
      开始水平测评
    </button>
  </view>
  <view wx:if="{{state.phase === 'assess'}}" class="hero">
    <view class="row between">
      <text>水平测评</text>
      <text class="badge">{{answered}} / 24</text>
    </view>
    <view class="sub">一次一题，不用着急。</view>
  </view>
  <view wx:if="{{state.plan}}" class="card">
    <view class="row between">
      <view class="menu-title">你的阅读计划</view>
      <text class="badge">{{done}} / {{state.plan.chapters.length}}</text>
    </view>
    <view class="sub">{{state.plan.text}}</view>
    <view wx:for="{{state.plan.chapters}}" wx:key="chapterId" class="task">
      <view class="row">
        <app-icon name="{{item.done ? 'check' : 'book'}}" size="34" />
        <text class="grow">{{item.title}}</text>
      </view>
      <view class="row task-actions">
        <button
          class="small"
          data-book="{{item.bookId}}"
          data-chapter="{{item.chapterId}}"
          bindtap="read"
        >
          阅读
        </button>
        <button
          class="small"
          data-book="{{item.bookId}}"
          data-chapter="{{item.chapterId}}"
          bindtap="quiz"
        >
          {{item.done ? '再练一次' : '章节闯关'}}
        </button>
      </view>
    </view>
    <button
      wx:if="{{state.phase === 'reading'}}"
      class="primary full"
      bindtap="qa"
      disabled="{{done !== state.plan.chapters.length || sending}}"
    >
      完成计划，进入问答
    </button>
  </view>
  <view class="conversation">
    <view
      wx:for="{{bubbles}}"
      wx:key="id"
      id="{{item.id}}"
      class="bubble {{item.role === 'user' ? 'mine' : ''}}"
    >
      <view class="caption">{{item.role === 'user' ? '我' : '阅读教练'}}</view>
      <text class="body-text" user-select>{{item.text}}</text>
      <view wx:if="{{item.question}}" class="question">
        <view class="question-title">{{item.question.title}}</view>
        <button
          wx:for="{{item.question.options}}"
          wx:for-item="option"
          wx:for-index="oi"
          wx:key="index"
          class="question-option"
          data-id="{{item.id}}"
          data-text="{{option}}"
          bindtap="pick"
          disabled="{{!item.actionable || sending}}"
        >
          {{oi === 0 ? 'A' : oi === 1 ? 'B' : oi === 2 ? 'C' : 'D'}}. {{option}}
        </button>
      </view>
    </view>
  </view>
  <view wx:if="{{sending}}" class="loading">教练正在思考…</view>
  <view wx:if="{{error}}" class="error">
    {{error}}
    <button class="small ghost" bindtap="retry">重试</button>
  </view>
  <view
    wx:if="{{state.phase === 'assess' || state.phase === 'qa'}}"
    class="composer"
  >
    <input
      class="field grow"
      value="{{input}}"
      bindinput="input"
      bindconfirm="submit"
      placeholder="写下你的回答或问题…"
      disabled="{{sending}}"
    />
    <button
      class="primary small"
      bindtap="submit"
      disabled="{{sending || !input}}"
    >
      发送
    </button>
  </view>
  <view class="sub" wx:if="{{state.phase === 'reading'}}">
    完成上方阅读任务与章节闯关后，可以继续向教练提问。
  </view>
</view>
