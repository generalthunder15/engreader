<view class="page" style="{{themeStyle}}">
  <image wx:if="{{themeBg}}" class="theme-bg" src="{{themeBg}}" mode="{{themeBgMode}}"></image>
  <view class="page-body">

    <!-- 空闲：开始摸底 -->
    <view class="hero" wx:if="{{phase === 'idle'}}">
      <view class="hero-icon">🎓</view>
      <view class="hero-title">AI 学习教练</view>
      <view class="hero-desc">
        AI 会先通过 24 道选择题了解你的英语水平，
        再从书架里挑选适合你的章节制定阅读计划；
        完成阅读与章节单词闯关后，AI 会针对内容继续考察你的掌握情况。
      </view>
      <view class="hero-btn" bindtap="startAssess">开始水平摸底</view>
    </view>

    <!-- 阅读任务横幅 -->
    <view class="plan-card" wx:if="{{plan && (phase === 'reading' || phase === 'qa')}}">
      <view class="plan-title">学习计划{{phase === 'qa' ? ' · 问答中' : ''}}</view>
      <view class="plan-text" wx:if="{{plan.text}}">{{plan.text}}</view>
      <view class="plan-progress">{{planDoneCount}}/{{planTotal}} 章完成闯关</view>
      <view
        class="plan-ch {{item.done ? 'done' : ''}}"
        wx:for="{{plan.chapters}}"
        wx:key="chapterId"
      >
        <view class="plan-ch-name">{{item.title}}{{item.done ? ' ✓' : ''}}</view>
        <view class="plan-ch-btns">
          <view class="pch-btn" catchtap="goRead" data-book="{{item.bookId}}" data-chapter="{{item.chapterId}}">去阅读</view>
          <view class="pch-btn alt" catchtap="goQuiz" data-book="{{item.bookId}}" data-chapter="{{item.chapterId}}">去闯关</view>
        </view>
      </view>
      <view class="plan-start-qa" wx:if="{{phase === 'reading' && planDoneCount === planTotal && planTotal > 0}}" bindtap="startQA">
        任务完成，开始 AI 问答
      </view>
    </view>

    <!-- 对话区 -->
    <scroll-view scroll-y class="chat" scroll-into-view="{{scrollInto}}" wx:if="{{phase !== 'idle'}}">
      <block wx:for="{{msgs}}" wx:key="id">
        <view id="wrap-{{item.id}}" class="row {{item.role === 'me' ? 'me' : ''}}">
          <view class="bubble {{item.role === 'me' ? 'me' : ''}}">
            <text>{{item.text}}</text>
            <!-- 交互题卡片 -->
            <view class="qcard" wx:if="{{item.q}}">
              <view class="q-title">{{item.q.title}}</view>
              <block wx:if="{{item.q.type === 'choice'}}">
                <view
                  class="q-opt"
                  wx:for="{{item.q.options}}"
                  wx:for-item="opt"
                  wx:for-index="oi"
                  wx:key="oi"
                  catchtap="pickOption"
                  data-i="{{oi}}"
                  data-text="{{opt}}"
                >{{['A','B','C','D'][oi]}}. {{opt}}</view>
              </block>
              <view class="q-input-hint" wx:else>在下方输入框作答</view>
            </view>
          </view>
        </view>
      </block>
      <view class="typing" wx:if="{{sending}}">AI 正在思考…</view>
      <view class="chat-pad"></view>
    </scroll-view>

    <!-- 输入区 -->
    <view class="inputbar" wx:if="{{phase !== 'idle'}}">
      <view class="locked" wx:if="{{!inputEnabled}}">
        <view class="locked-icon">🔒</view>
        <view class="locked-text">{{inputTip || '等待任务解锁'}}</view>
      </view>
      <block wx:else>
        <input
          class="chat-input"
          value="{{input}}"
          bindinput="onInput"
          bindconfirm="sendInput"
          confirm-type="send"
          disabled="{{sending}}"
          placeholder="{{sending ? 'AI 正在思考…' : '输入你的回答或问题…'}}"
          placeholder-class="ph"
          show-confirm-bar="{{false}}"
          adjust-position="{{true}}"
        />
        <view class="send-btn {{sending || !input ? 'dim' : ''}}" bindtap="sendInput">发送</view>
      </block>
      <view class="reset-link" bindtap="resetAll">重置</view>
    </view>

  </view>
</view>
