<view class="page tab-page" style="{{themeStyle}}">
  <view class="eyebrow">ONE LESSON AT A TIME</view>
  <view class="heading">与你一起，循序渐进</view>
  <view class="sub">一篇文章，一次深入学习。每三课，温习一次。</view>
  <view class="row lesson-actions">
    <button wx:if="{{!hasAssessment}}" class="primary" bindtap="start">
      先认识一下你
    </button>
    <button
      wx:else
      class="primary"
      bindtap="newLesson"
      disabled="{{!canNew || busy}}"
    >
      开启新一课
    </button>
  </view>
  <view wx:if="{{hasAssessment && !canNew}}" class="caption">
    完成测评或当前课程的全部错题复测后，才能开启下一课。
  </view>
  <picker
    wx:if="{{sessions.length > 1}}"
    range="{{sessions}}"
    range-key="title"
    value="{{sessionIndex}}"
    bindchange="select"
    disabled="{{busy}}"
  >
    <view class="session-switch">切换对话 / 查看历史记录 ›</view>
  </picker>
  <block wx:if="{{current}}">
    <view class="card">
      <view class="menu-title">{{current.title}}</view>
      <view class="sub">{{label}}</view>
      <view wx:if="{{current.phase === 'assessment'}}" class="caption">
        已完成 {{current.assessed}} / 24 题
      </view>
      <view wx:if="{{current.phase === 'remediation'}}" class="caption">
        还有 {{remaining}} 个知识点需要通过新题复测
      </view>
      <view wx:if="{{current.phase === 'intro'}}" class="sub">
        介绍一下你的英语基础、学习目标、薄弱项和每天可用的时间。按自己的方式说就好。
      </view>
      <view
        wx:if="{{current.kind === 'lesson' && current.phase !== 'generating'}}"
        class="row lesson-actions"
      >
        <button class="small" bindtap="read">阅读文章</button>
        <button
          wx:if="{{current.phase === 'reading'}}"
          class="small"
          bindtap="quiz"
        >
          单词闯关
        </button>
        <button
          wx:if="{{current.generationStep === 21}}"
          class="small"
          bindtap="exam"
        >
          {{current.submitted ? '查看试卷' : '开始答卷'}}
        </button>
      </view>
    </view>
    <view class="row lesson-actions">
      <button wx:if="{{hasOlder}}" class="small ghost" bindtap="older">
        查看更早记录
      </button>
      <button wx:if="{{historyPage}}" class="small ghost" bindtap="latest">
        回到最新记录
      </button>
    </view>
    <view
      wx:for="{{current.messages}}"
      wx:key="id"
      class="bubble {{item.role === 'user' ? 'mine' : ''}}"
    >
      <view class="caption">{{item.role === 'user' ? '我' : '学习教练'}}</view>
      <view class="body-text"><word-text text="{{item.content}}" selected="{{selectedWord}}" bind:word="selectWord" /></view>
      <view wx:if="{{item.question}}" class="question">
        <view class="body-text"><word-text text="{{item.question.title}}" selected="{{selectedWord}}" bind:word="selectWord" /></view>
        <view
          wx:for="{{item.question.options}}"
          wx:key="index"
          wx:for-item="option"
          class="sub"
        >
          <word-text text="{{option}}" selected="{{selectedWord}}" bind:word="selectWord" />
        </view>
      </view>
    </view>
    <view wx:if="{{current.pending && !readonly}}" class="card">
      <view class="caption">回答当前题目</view>
      <view wx:if="{{current.pending.type === 'choice'}}" class="answer-options">
        <button
          wx:for="{{current.pending.options}}"
          wx:key="index"
          class="question-option {{selectedOption === (index === 0 ? 'A' : index === 1 ? 'B' : index === 2 ? 'C' : 'D') ? 'chosen' : ''}}"
          data-option="{{index === 0 ? 'A' : index === 1 ? 'B' : index === 2 ? 'C' : 'D'}}"
          bindtap="chooseOption"
          disabled="{{busy}}"
        >
          {{index === 0 ? 'A' : index === 1 ? 'B' : index === 2 ? 'C' : 'D'}}
        </button>
      </view>
      <block>
        <textarea
          class="field textarea"
          value="{{answer}}"
          bindinput="answer"
          placeholder="{{current.pending.type === 'choice' ? '补充你的思路或疑问（选填）…' : '在这里填写答案…'}}"
          maxlength="5000"
          show-confirm-bar="{{false}}"
          disabled="{{busy}}"
        />
        <button
          class="primary full"
          bindtap="answerQuestion"
          disabled="{{busy || (current.pending.type === 'choice' ? !selectedOption : !answer)}}"
        >
          确认发送
        </button>
      </block>
    </view>
    <view wx:if="{{busy}}" class="loading">
      {{progress || '教练正在思考…'}}
    </view>
    <view wx:if="{{error}}" class="error">{{error}}</view>
    <button
      wx:if="{{!readonly && current.phase !== 'intro' && current.phase !== 'exam' && !current.pending}}"
      class="full"
      bindtap="advance"
      disabled="{{busy}}"
    >
      {{current.phase === 'generating' || current.phase === 'exam-generating' ? '继续生成 / 重试' : current.phase === 'grading' ? '批改试卷 / 重试' : current.phase === 'reading' ? '已完成闯关，继续学习' : '继续学习 / 重试'}}
    </button>
    <view
      wx:if="{{current.phase === 'intro' || current.phase === 'teaching' || current.phase === 'remediation'}}"
      class="chat-compose"
    >
      <textarea
        class="field textarea"
        value="{{text}}"
        bindinput="text"
        placeholder="{{current.phase === 'intro' ? '我的英语基础和目标是…' : '可以聊聊文章，或提出你的疑问…'}}"
        maxlength="5000"
        show-confirm-bar="{{false}}"
        disabled="{{busy}}"
      />
      <button class="primary full" bindtap="send" disabled="{{busy || !text}}">
        {{current.phase === 'intro' ? '介绍好了，开始测评' : '发送'}}
      </button>
    </view>
    <view wx:if="{{readonly}}" class="sub">
      这段对话已归档，可以随时回来查看。
    </view>
  </block>
  <view wx:if="{{selectedWord && !wordPanel}}" class="selection-bar {{wordMenuSide}}" style="{{wordMenuStyle}}">
    <view class="selection-arrow" style="left:{{wordArrow}}px"></view>
    <view class="selection-actions">
      <view class="selection-action" aria-role="button" hover-class="selection-action-hover" bindtap="translateWord"><app-icon name="translate" size="34" /><text>翻译</text></view>
      <view class="selection-action" aria-role="button" hover-class="selection-action-hover" bindtap="closeWord"><app-icon name="close" size="34" /><text>取消</text></view>
    </view>
  </view>
  <block wx:if="{{wordPanel}}">
    <view class="mask" bindtap="closeWord"></view>
    <view class="sheet analysis-sheet">
      <view class="sheet-head">
        <view class="chips panel-tabs"><view class="chip active">释义</view></view>
        <button class="icon-button" bindtap="closeWord" aria-label="关闭翻译面板"><app-icon name="close" size="32" /></button>
      </view>
      <scroll-view scroll-y class="sheet-scroll">
        <view class="quote">{{selectedWord}}</view>
        <view wx:if="{{wordBusy}}" class="loading">正在分析，请稍候…</view>
        <view wx:if="{{wordError}}" class="error">{{wordError}}</view>
        <view wx:if="{{wordDefinition}}">
          <view class="definition">{{wordDefinition.translation}}</view>
          <view class="caption">{{wordDefinition.phonetic}} {{wordDefinition.pos}}</view>
          <view class="badge" wx:if="{{wordDefinition.source === 'offline'}}">内置离线释义</view>
          <view class="sub" wx:for="{{wordDefinition.senses}}" wx:key="index">{{item}}</view>
          <view wx:if="{{wordDefinition.example}}" class="card"><text class="body-text">{{wordDefinition.example}}</text><view class="caption">{{wordDefinition.exampleTranslation}}</view></view>
        </view>
        <view class="row wrap panel-actions">
          <button class="small" bindtap="playWord">{{wordPlaying ? '停止朗读' : '朗读'}}</button>
          <button wx:if="{{wordDefinition}}" class="small" disabled>已加入生词本</button>
          <button wx:if="{{wordError}}" class="small" bindtap="translateWord" disabled="{{wordBusy}}">重试</button>
        </view>
      </scroll-view>
    </view>
  </block>
</view>
