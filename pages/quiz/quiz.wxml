<view class="page tab-page" style="{{themeStyle}}">
  <view class="row between">
    <view>
      <view class="eyebrow">A LITTLE EVERY DAY</view>
      <view class="heading">单词闯关</view>
    </view>
    <app-icon name="spark" size="58" />
  </view>
  <view class="sub">{{title}}</view>
  <view class="loading" wx:if="{{busy}}">正在准备词表…</view>
  <block wx:elif="{{phase === 'running' && current}}">
    <view class="quiz-progress">
      <view class="row between caption">
        <text>还有 {{remaining}} 个词</text>
        <text>{{total}} 个目标词</text>
      </view>
      <view class="progress">
        <view class="progress-fill" style="width:{{progress}}%"></view>
      </view>
    </view>
    <view class="word-card">
      <view class="caption">认识这个词吗？</view>
      <view class="quiz-word">{{current.word}}</view>
      <view
        class="speak"
        bindtap="speak"
        role="button"
        aria-role="button"
        aria-label="朗读单词"
        hover-class="speak-hover"
      >
        <app-icon name="volume" size="38" />
        <text>听发音</text>
      </view>
    </view>
    <view class="options">
      <view
        wx:for="{{current.options}}"
        wx:key="index"
        class="option {{result && index === current.answer ? 'correct' : ''}} {{result === 'wrong' && index === picked ? 'incorrect' : ''}}"
        data-index="{{index}}"
        bindtap="pick"
        role="button"
        aria-role="button"
        aria-disabled="{{!!result}}"
        hover-class="{{result ? 'none' : 'option-hover'}}"
      >
        <!-- prettier-ignore -->
        <view class="option-letter">{{index === 0 ? 'A' : index === 1 ? 'B' : index === 2 ? 'C' : 'D'}}</view>
        <text class="option-meaning">{{item}}</text>
      </view>
    </view>
    <view class="feedback {{result === 'wrong' ? 'danger' : ''}}">
      {{result === 'right' ? '答对了，继续保持' : result === 'wrong' ?
      '记住正确释义，稍后再练一次' : '选择最合适的释义'}}
    </view>
  </block>
  <view class="empty" wx:elif="{{phase === 'done'}}">
    <app-icon name="check" size="100" />
    <view class="empty-title">这一轮，完成了</view>
    <view class="sub">首次答对 {{passed}} / {{total}} · 错误 {{wrong}} 次</view>
    <view wx:if="{{skipped}}" class="error">
      {{skipped}} 个词缺少释义未完成，本章暂未标记通过。
    </view>
    <button class="primary" bindtap="start">再练一轮</button>
  </view>
  <view class="empty" wx:elif="{{phase === 'empty'}}">
    <app-icon name="book" size="90" />
    <view class="empty-title">还没有可练习的词</view>
    <view class="sub">在阅读时收藏生词，或从章节进入闯关。</view>
    <button bindtap="vocab">查看生词本</button>
    <button class="ghost" bindtap="start">重新加载</button>
  </view>
  <view class="hero intro" wx:else>
    <app-icon name="leaf" size="90" />
    <view class="intro-title">让认识，变成熟悉。</view>
    <view class="sub">
      每次练习最近收藏的词汇。
      <text>{{"\n"}}</text>
      答错的词会再次出现，直到全部掌握。
    </view>
    <button class="primary" bindtap="start">开始练习</button>
    <button class="ghost" bindtap="vocab">查看我的生词本</button>
  </view>
  <button class="ghost full" wx:if="{{chapterMode}}" bindtap="normal">
    返回生词本闯关
  </button>
</view>

<app-dialog id="app-dialog" style="{{themeStyle}}" />
