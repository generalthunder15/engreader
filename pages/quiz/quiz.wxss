.quiz-progress {
  margin-top: 42rpx;
}
.progress {
  margin-top: 18rpx;
}
.word-card {
  text-align: center;
  padding: 65rpx 0 45rpx;
}
.quiz-word {
  font-size: 66rpx;
  font-family: Georgia, serif;
  line-height: 1.4;
  margin: 24rpx 0;
  word-break: break-word;
}
.speak {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  font-size: 23rpx;
  border-radius: 40rpx;
  padding: 12rpx 22rpx;
}
.options {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}
.option {
  display: flex;
  align-items: center;
  text-align: left;
  gap: 22rpx;
  background: var(--card);
  color: var(--text);
  padding: 28rpx;
  border: 2rpx solid var(--line);
  min-height: 102rpx;
  font-weight: 400;
}
.option-letter {
  font-size: 23rpx;
  color: var(--muted);
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  flex-shrink: 0;
}
.option[disabled] {
  opacity: 1;
  color: var(--text);
}
.option.correct {
  border-color: var(--primary);
  background: var(--soft);
}
.option.incorrect {
  border-color: var(--danger);
  color: var(--danger);
}
.feedback {
  min-height: 70rpx;
  text-align: center;
  padding-top: 28rpx;
  font-size: 24rpx;
  color: var(--muted);
}
.intro {
  text-align: center;
  padding: 65rpx 30rpx;
  margin-top: 45rpx;
}
.intro-title {
  font-size: 39rpx;
  margin-top: 28rpx;
}
.intro .primary {
  margin-top: 44rpx;
}
