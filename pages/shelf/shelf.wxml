<view class="page tab-page" style="{{themeStyle}}">
  <view class="row between">
    <view>
      <view class="eyebrow">YOUR READING SPACE</view>
      <view class="heading">我的书架</view>
    </view>
    <button class="icon-button" bindtap="create" aria-label="新建书籍">
      <app-icon name="plus" size="48" />
    </button>
  </view>
  <view class="sub">把每一次阅读，变成一点进步。</view>
  <view class="hero row between">
    <view>
      <view class="menu-title">慢慢读，认真懂。</view>
      <view class="sub">{{books.length}} 本书 · {{totalChapters}} 个章节</view>
    </view>
    <app-icon name="leaf" size="72" />
  </view>
  <view class="row between">
    <view class="section-title">全部书籍</view>
    <text class="caption">长按书籍可删除</text>
  </view>
  <view class="books" wx:if="{{books.length}}">
    <view
      class="book"
      wx:for="{{books}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="open"
      bindlongpress="remove"
    >
      <view class="cover" style="{{item.cover}}">
        <view class="cover-line"></view>
        <text class="cover-label">ENGLISH READER</text>
        <view class="cover-title">{{item.title}}</view>
        <text class="cover-author">{{item.author || '我的阅读集'}}</text>
        <view class="cover-footer">{{item.chapterCount}} CHAPTERS</view>
      </view>
      <view class="book-name">{{item.title}}</view>
      <view class="caption">{{item.subtitle}}</view>
    </view>
  </view>
  <view class="empty" wx:else>
    <app-icon name="book" size="88" />
    <view class="empty-title">从第一本书开始</view>
    <view class="sub">创建书籍，粘贴你想精读的英语文章。</view>
    <button class="primary" bindtap="create">创建书籍</button>
  </view>
  <button wx:if="{{books.length}}" bindtap="create" class="add-book">
    ＋ 创建新书
  </button>
</view>

<app-dialog id="app-dialog" style="{{themeStyle}}" />
