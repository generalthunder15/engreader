.page { min-height: 100vh; background: var(--c-bg); position: relative; }
.theme-bg { position: fixed; left: 0; top: 0; width: 100vw; height: 100vh; z-index: 0; }
.page-body { position: relative; z-index: 1; padding: 30rpx 30rpx 180rpx; }

.head { display: flex; align-items: baseline; margin-bottom: 28rpx; }
.head-title { font-size: 44rpx; font-weight: 700; color: var(--c-text-strong); }
.head-sub { margin-left: 16rpx; font-size: 24rpx; color: var(--c-text-hint); }

.grid { display: flex; flex-wrap: wrap; gap: 24rpx; }
.book-card { width: calc((100% - 24rpx) / 2); }
.cover {
  height: 300rpx; border-radius: var(--r-card);
  padding: 28rpx; box-sizing: border-box;
  display: flex; flex-direction: column; justify-content: space-between;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.08);
}
.cover-title {
  font-size: 32rpx; font-weight: 700; line-height: 1.4;
  display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 3; overflow: hidden;
}
.cover-author { font-size: 24rpx; opacity: 0.75; }
.book-meta { padding: 14rpx 6rpx 0; }
.book-name {
  font-size: 28rpx; color: var(--c-text); font-weight: 600;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.book-sub { font-size: 22rpx; color: var(--c-text-hint); margin-top: 6rpx; }

.empty { padding: 160rpx 0 80rpx; text-align: center; }
.empty-icon { font-size: 90rpx; }
.empty-text { margin-top: 24rpx; font-size: 32rpx; color: var(--c-text-sub); font-weight: 600; }
.empty-hint { margin-top: 12rpx; font-size: 24rpx; color: var(--c-text-hint); }

.fab {
  position: fixed; left: 50%; transform: translateX(-50%);
  bottom: calc(140rpx + env(safe-area-inset-bottom));
  background: var(--c-primary); color: var(--c-on-primary);
  font-size: 30rpx; font-weight: 600;
  padding: 22rpx 56rpx; border-radius: 60rpx;
  box-shadow: 0 10rpx 24rpx rgba(0, 0, 0, 0.18);
}
