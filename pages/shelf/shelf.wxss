.books {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 34rpx 28rpx;
}
.cover {
  height: 368rpx;
  border-radius: 8rpx 18rpx 18rpx 8rpx;
  padding: 32rpx 26rpx 24rpx 32rpx;
  color: #fff;
  position: relative;
  box-shadow: 5rpx 10rpx 20rpx rgba(25, 45, 35, 0.1);
  display: flex;
  flex-direction: column;
}
.cover-line {
  position: absolute;
  left: 12rpx;
  top: 0;
  bottom: 0;
  border-left: 1rpx solid rgba(255, 255, 255, 0.15);
}
.cover-label {
  font-size: 14rpx;
  letter-spacing: 3rpx;
  opacity: 0.6;
}
.cover-title {
  font-size: 35rpx;
  line-height: 1.45;
  font-weight: 500;
  margin: 38rpx 0 18rpx;
  flex: 1;
}
.cover-author {
  font-size: 21rpx;
  opacity: 0.72;
}
.cover-footer {
  font-size: 16rpx;
  letter-spacing: 2rpx;
  margin-top: 25rpx;
  opacity: 0.55;
}
.book-name {
  font-weight: 550;
  margin: 20rpx 0 7rpx;
  line-height: 1.5;
}
.add-book {
  margin-top: 36rpx;
  background: transparent;
  border: 1rpx dashed var(--line);
  color: var(--primary);
}
