.mini-cover {
  width: 130rpx;
  height: 180rpx;
  border-radius: 10rpx 18rpx 18rpx 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.hero .heading {
  font-size: 36rpx;
}
.chapter {
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.chapter:last-child {
  border-bottom: 0;
}
.chapter .menu-title {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.chapter-number {
  flex-shrink: 0;
  font-size: 30rpx;
  color: var(--muted);
  width: 44rpx;
}

.book-actions { display: flex; gap: 18rpx; margin: 26rpx 0 10rpx; }
.book-actions button { flex: 1; width: 0; min-width: 0; margin: 0; padding: 22rpx 12rpx; }
.coach-entry { display: flex; align-items: center; justify-content: center; gap: 12rpx; }
.chapter-exam { flex: 0 0 80rpx; width: 80rpx; min-width: 0; max-width: 80rpx; margin: 0; padding: 12rpx 0; border-radius: 18rpx; font-size: 24rpx; background: var(--soft); color: var(--primary); }
