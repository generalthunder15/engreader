.page { min-height: 100vh; background: var(--c-bg); position: relative; }
.theme-bg { position: fixed; left: 0; top: 0; width: 100vw; height: 100vh; z-index: 0; }
.page-body { position: relative; z-index: 1; padding: 30rpx; }

.book-head { display: flex; align-items: center; background: var(--c-card); border-radius: var(--r-card); padding: 28rpx; }
.mini-cover {
  width: 120rpx; height: 160rpx; border-radius: 12rpx; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  font-size: 44rpx; font-weight: 700;
}
.book-info { flex: 1; min-width: 0; margin-left: 24rpx; }
.book-title { font-size: 34rpx; font-weight: 700; color: var(--c-text-strong); }
.book-sub { font-size: 24rpx; color: var(--c-text-hint); margin-top: 8rpx; }
.read-btn {
  flex-shrink: 0; margin-left: 16rpx;
  background: var(--c-primary); color: var(--c-on-primary);
  font-size: 26rpx; font-weight: 600;
  padding: 16rpx 28rpx; border-radius: var(--r-btn);
}

.sec-bar { display: flex; align-items: center; justify-content: space-between; margin: 34rpx 6rpx 18rpx; }
.sec-title { font-size: 30rpx; font-weight: 700; color: var(--c-text-strong); }
.sec-add { font-size: 26rpx; color: var(--c-primary); font-weight: 600; }

.ch-list { background: var(--c-card); border-radius: var(--r-card); overflow: hidden; }
.ch-item { display: flex; align-items: center; padding: 26rpx 28rpx; border-bottom: 1rpx solid var(--c-border); }
.ch-item:last-child { border-bottom: none; }
.ch-idx { width: 56rpx; font-size: 28rpx; color: var(--c-text-hint); flex-shrink: 0; }
.ch-main { flex: 1; min-width: 0; }
.ch-title { font-size: 30rpx; color: var(--c-text); font-weight: 600; }
.ch-meta { display: flex; gap: 16rpx; margin-top: 8rpx; font-size: 22rpx; color: var(--c-text-hint); }
.ch-tag { color: var(--c-tag-text); background: var(--c-tag-bg); border-radius: 8rpx; padding: 2rpx 10rpx; }
.ch-tag.ok { color: var(--c-primary); background: var(--c-primary-weak); }
.ch-edit { flex-shrink: 0; font-size: 24rpx; color: var(--c-primary); padding: 8rpx 0 8rpx 20rpx; }

.empty { padding: 80rpx 0; text-align: center; }
.empty-hint { font-size: 26rpx; color: var(--c-text-hint); }
