.mini-cover {
  width: 130rpx;
  height: 180rpx;
  border-radius: 10rpx 18rpx 18rpx 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.hero .heading {
  font-size: 36rpx;
}
.chapter {
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.chapter:last-child {
  border-bottom: 0;
}
.chapter .menu-title {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.chapter-number {
  flex-shrink: 0;
  font-size: 30rpx;
  color: var(--muted);
  width: 44rpx;
}
