<view class="page" style="{{themeStyle}}">
  <block wx:if="{{book}}">
    <view class="hero row">
      <view class="mini-cover" style="{{cover}}">
        <app-icon name="book" size="68" />
      </view>
      <view class="grow">
        <view class="heading">{{book.title}}</view>
        <view class="sub">{{book.author || '我的阅读集'}}</view>
        <view class="caption">
          {{book.chapterCount}} 章 · 已完成 {{finished}} 章闯关
        </view>
      </view>
    </view>
    <button class="primary" bindtap="resume">继续阅读</button>
    <view class="row between">
      <view class="section-title">章节目录</view>
      <button class="small ghost" bindtap="add">＋ 添加章节</button>
    </view>
    <view class="card" wx:if="{{book.chapters.length}}">
      <view class="chapter" wx:for="{{book.chapters}}" wx:key="id">
        <view class="row" data-id="{{item.id}}" bindtap="open">
          <text class="chapter-number">{{index + 1}}</text>
          <view class="grow">
            <view class="menu-title">{{item.title}}</view>
            <view class="caption">
              {{item.wordCount}} 个词语 · {{item.quizDone ? '已闯关' :
              '待学习'}}{{item.translated ? ' · 已句译' : ''}}
            </view>
          </view>
          <app-icon name="arrow" size="30" />
        </view>
        <view class="row chapter-actions">
          <button class="small ghost" data-id="{{item.id}}" bindtap="edit">
            编辑
          </button>
          <button
            class="small ghost danger"
            data-id="{{item.id}}"
            bindtap="remove"
          >
            删除
          </button>
        </view>
      </view>
    </view>
    <view class="empty" wx:else>
      <app-icon name="note" size="80" />
      <view class="empty-title">还没有章节</view>
      <view class="sub">添加正文与词表，开始这本书的精读。</view>
      <button bindtap="add">添加第一章</button>
    </view>
  </block>
  <view class="empty" wx:else>这本书已不存在</view>
</view>
