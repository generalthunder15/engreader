.label:first-child {
  margin-top: 0;
}
.font-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}
.font-row button {
  text-align: left;
}
.diagnostic {
  padding: 18rpx 0;
  border-top: 1rpx solid var(--line);
}
.diagnostic .caption {
  margin-top: 10rpx;
  word-break: break-all;
}
