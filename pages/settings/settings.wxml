<view class="page" style="{{themeStyle}}">
  <view class="eyebrow">MAKE READING FEEL RIGHT</view>
  <view class="heading">按你的习惯来</view>
  <view class="sub">外观即时生效；接口与练习选项修改后请保存。</view>
  <view class="section-title">阅读外观</view>
  <view class="card">
    <view class="label">主题</view>
    <scroll-view scroll-x class="appearance-options" show-scrollbar="{{false}}">
      <view
        aria-role="button"
        wx:for="{{themes}}"
        wx:key="id"
        class="chip {{form.theme === item.id ? 'active' : ''}}"
        data-key="theme"
        data-value="{{item.id}}"
        bindtap="appearance"
      >
        {{item.name}}
      </view>
    </scroll-view>
    <view class="label">字号</view>
    <scroll-view scroll-x class="appearance-options" show-scrollbar="{{false}}">
      <view
        aria-role="button"
        wx:for="{{sizes}}"
        wx:key="*this"
        class="chip {{form.readFontSize === item ? 'active' : ''}}"
        data-key="readFontSize"
        data-value="{{item}}"
        bindtap="appearance"
      >
        {{item}}
      </view>
      <view
        aria-role="button"
        class="chip {{form.readFontSize === 0 ? 'active' : ''}}"
        data-key="readFontSize"
        data-value="0"
        bindtap="appearance"
      >
        默认
      </view>
    </scroll-view>
    <view class="reading-preview">
      <view class="caption">字号预览 · {{form.readFontSize || 36}}</view>
      <view class="preview-text">
        A little reading every day opens a new world.
      </view>
      <view class="preview-text">每天读一点，看见更大的世界。</view>
    </view>
    <view class="label">行距</view>
    <scroll-view scroll-x class="appearance-options" show-scrollbar="{{false}}">
      <view
        aria-role="button"
        wx:for="{{lines}}"
        wx:key="*this"
        class="chip {{form.readLineHeight === item ? 'active' : ''}}"
        data-key="readLineHeight"
        data-value="{{item}}"
        bindtap="appearance"
      >
        {{item}}
      </view>
    </scroll-view>
    <view class="list-row between">
      <text>首行缩进</text>
      <switch
        checked="{{form.readIndent !== 0}}"
        bindchange="indent"
        color="{{themePrimary}}"
      />
    </view>
    <view class="list-row between">
      <text>界面使用阅读字体</text>
      <switch
        checked="{{form.fontUi !== 'system'}}"
        bindchange="sameFont"
        color="{{themePrimary}}"
      />
    </view>
    <view class="label">阅读字体</view>
    <scroll-view
      scroll-x
      class="appearance-options font-options"
      show-scrollbar="{{false}}"
    >
      <view class="font-row" wx:for="{{fonts}}" wx:key="id">
        <view
          aria-role="button"
          class="chip {{form.fontRead === item.id ? 'active' : ''}}"
          data-key="fontRead"
          data-value="{{item.id}}"
          bindtap="appearance"
        >
          {{item.name}}
          <text class="caption">
            {{item.kind === 'custom' ? '已导入' : item.kind === 'builtin' ?
            '内置' : '系统'}}
          </text>
        </view>
        <button
          wx:if="{{item.kind === 'custom'}}"
          class="small ghost"
          data-id="{{item.id}}"
          bindtap="removeFont"
        >
          删除
        </button>
      </view>
    </scroll-view>
    <button class="ghost full" bindtap="importFont">＋ 导入字体文件</button>
  </view>
  <view class="section-title">AI 模型</view>
  <view class="card">
    <view class="caption">统一使用硅基流动，精读、学习教练和朗读共用一个 API Key。模型由系统维护，随版本更新。</view>
    <view class="label">API Key</view>
    <input
      class="field"
      password
      value="{{form.apiKey}}"
      data-key="apiKey"
      disabled="{{testing}}"
      bindinput="field"
      placeholder="填写硅基流动 API Key"
    />
    <view class="stack api-test">
    <view class="settings-actions">
      <button bindtap="test" disabled="{{testing}}" aria-label="检测接口连通性">
        {{testing ? '检测中…' : '检测连接'}}
      </button>
      <button
        bindtap="testModel"
        disabled="{{testing}}"
        aria-label="测试主模型响应"
      >
        测试模型
      </button>
      <button bindtap="domains" aria-label="复制使用的域名">复制域名</button>
    </view>
    <view class="caption">
      填写 Key 后可直接测试模型，测试通过后记得保存设置。
    </view>
    <view class="body-text sub">{{testMessage}}</view>
    <view wx:for="{{results}}" wx:key="url" class="diagnostic">
      <view class="row between">
        <text>{{item.name}}{{item.optional ? '（可选）' : ''}}</text>
        <text class="badge">{{item.ok ? '可连接' : '未连接'}}</text>
      </view>
      <view class="caption">{{item.detail}}</view>
    </view>
  </view>
  </view>
  <button class="primary full" bindtap="saveAI" disabled="{{testing}}">保存 AI 设置</button>
  <view class="section-title">朗读与练习</view>
  <view class="card">
    <view class="label">朗读语速 · {{form.ttsSpeed}}×</view>
    <slider
      min="0.5"
      max="2"
      step="0.1"
      value="{{form.ttsSpeed}}"
      data-key="ttsSpeed"
      bindchange="number"
      activeColor="{{themePrimary}}"
    />
    <view class="label">每轮生词数量 · {{form.quizCount}} 个</view>
    <slider
      min="5"
      max="100"
      step="5"
      value="{{form.quizCount}}"
      data-key="quizCount"
      bindchange="number"
      activeColor="{{themePrimary}}"
    />
    <view class="list-row between">
      <text>自动朗读</text>
      <switch
        checked="{{form.autoPlay}}"
        data-key="autoPlay"
        bindchange="toggle"
        color="{{themePrimary}}"
      />
    </view>
    <view class="list-row between">
      <text>显示句译</text>
      <switch
        checked="{{form.showTrans}}"
        data-key="showTrans"
        bindchange="toggle"
        color="{{themePrimary}}"
      />
    </view>
    <view class="list-row between">
      <view class="grow">
        <text>本地兜底</text>
        <view class="caption">联网失败时使用内置词库和已有句译</view>
      </view>
      <switch
        checked="{{form.localFallback}}"
        data-key="localFallback"
        bindchange="toggle"
        color="{{themePrimary}}"
      />
    </view>
  </view>
  <button class="primary full" bindtap="savePractice">保存朗读与练习设置</button>
  <view class="section-title">数据与连接</view>
  <view class="card stack">
    <view class="settings-actions">
      <button bindtap="clearCache" aria-label="清理可再生成的缓存">
        清理缓存
      </button>
    </view>
    <view class="caption">清理可重新生成的缓存，保留书籍、笔记和学习记录。</view>
  </view>

</view>
