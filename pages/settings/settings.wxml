<view class="page" style="{{themeStyle}}">
  <view class="eyebrow">MAKE READING FEEL RIGHT</view>
  <view class="heading">按你的习惯来</view>
  <view class="sub">外观即时生效；接口与练习选项修改后请保存。</view>
  <view class="section-title">阅读外观</view>
  <view class="card">
    <view class="label">主题</view>
    <view class="chips">
      <button
        wx:for="{{themes}}"
        wx:key="id"
        class="chip {{form.theme === item.id ? 'active' : ''}}"
        data-key="theme"
        data-value="{{item.id}}"
        bindtap="appearance"
      >
        {{item.name}}
      </button>
    </view>
    <view class="label">字号</view>
    <view class="chips">
      <button
        wx:for="{{sizes}}"
        wx:key="*this"
        class="chip {{form.readFontSize === item ? 'active' : ''}}"
        data-key="readFontSize"
        data-value="{{item}}"
        bindtap="appearance"
      >
        {{item}}
      </button>
      <button
        class="chip"
        data-key="readFontSize"
        data-value="0"
        bindtap="appearance"
      >
        默认
      </button>
    </view>
    <view class="label">行距</view>
    <view class="chips">
      <button
        wx:for="{{lines}}"
        wx:key="*this"
        class="chip {{form.readLineHeight === item ? 'active' : ''}}"
        data-key="readLineHeight"
        data-value="{{item}}"
        bindtap="appearance"
      >
        {{item}}
      </button>
    </view>
    <view class="list-row between">
      <text>首行缩进</text>
      <switch
        checked="{{form.readIndent !== 0}}"
        bindchange="indent"
        color="{{themePrimary}}"
      />
    </view>
    <view class="list-row between">
      <text>界面使用阅读字体</text>
      <switch
        checked="{{form.fontUi !== 'system'}}"
        bindchange="sameFont"
        color="{{themePrimary}}"
      />
    </view>
    <view class="label">阅读字体</view>
    <view class="font-row" wx:for="{{fonts}}" wx:key="id">
      <button
        class="chip grow {{form.fontRead === item.id ? 'active' : ''}}"
        data-key="fontRead"
        data-value="{{item.id}}"
        bindtap="appearance"
      >
        {{item.name}}
        <text class="caption">
          {{item.kind === 'custom' ? '已导入' : item.kind === 'builtin' ? '内置'
          : '系统'}}
        </text>
      </button>
      <button
        wx:if="{{item.kind === 'custom'}}"
        class="small ghost"
        data-id="{{item.id}}"
        bindtap="removeFont"
      >
        删除
      </button>
    </view>
    <button class="ghost full" bindtap="importFont">＋ 导入字体文件</button>
  </view>
  <view class="section-title">AI 模型</view>
  <view class="card">
    <view class="caption">
      支持 OpenAI 兼容接口，主模型用于精读与学习教练。
    </view>
    <view class="label">接口地址</view>
    <input
      class="field"
      value="{{form.baseUrl}}"
      data-key="baseUrl"
      bindinput="field"
      placeholder="https://api.example.com/v1"
    />
    <view class="label">模型名称</view>
    <input
      class="field"
      value="{{form.model}}"
      data-key="model"
      bindinput="field"
    />
    <view class="label">API Key</view>
    <input
      class="field"
      password
      value="{{form.apiKey}}"
      data-key="apiKey"
      bindinput="field"
      placeholder="填写你的 API Key"
    />
    <view class="divider"></view>
    <view class="menu-title">辅助模型（可选）</view>
    <view class="caption">用于词表提取和批量翻译，留空 Key 时使用主模型。</view>
    <view class="label">接口地址</view>
    <input
      class="field"
      value="{{form.sfBaseUrl}}"
      data-key="sfBaseUrl"
      bindinput="field"
    />
    <view class="label">模型名称</view>
    <input
      class="field"
      value="{{form.sfModel}}"
      data-key="sfModel"
      bindinput="field"
    />
    <view class="label">API Key</view>
    <input
      class="field"
      password
      value="{{form.sfApiKey}}"
      data-key="sfApiKey"
      bindinput="field"
    />
  </view>
  <view class="section-title">朗读与练习</view>
  <view class="card">
    <view class="label">高品质朗读 Key（可选）</view>
    <input
      class="field"
      password
      value="{{form.ttsApiKey}}"
      data-key="ttsApiKey"
      bindinput="field"
      placeholder="硅基流动 Key，留空使用免费朗读"
    />
    <view class="label">朗读语速 · {{form.ttsSpeed}}×</view>
    <slider
      min="0.5"
      max="2"
      step="0.1"
      value="{{form.ttsSpeed}}"
      data-key="ttsSpeed"
      bindchange="number"
      activeColor="{{themePrimary}}"
    />
    <view class="label">每轮生词数量 · {{form.quizCount}} 个</view>
    <slider
      min="5"
      max="100"
      step="5"
      value="{{form.quizCount}}"
      data-key="quizCount"
      bindchange="number"
      activeColor="{{themePrimary}}"
    />
    <view class="list-row between">
      <text>自动朗读</text>
      <switch
        checked="{{form.autoPlay}}"
        data-key="autoPlay"
        bindchange="toggle"
        color="{{themePrimary}}"
      />
    </view>
    <view class="list-row between">
      <text>显示句译</text>
      <switch
        checked="{{form.showTrans}}"
        data-key="showTrans"
        bindchange="toggle"
        color="{{themePrimary}}"
      />
    </view>
    <view class="list-row between">
      <view class="grow">
        <text>本地兜底</text>
        <view class="caption">联网失败时使用内置词库和已有句译</view>
      </view>
      <switch
        checked="{{form.localFallback}}"
        data-key="localFallback"
        bindchange="toggle"
        color="{{themePrimary}}"
      />
    </view>
  </view>
  <button class="primary full" bindtap="save">保存接口与练习设置</button>
  <view class="section-title">数据与连接</view>
  <view class="card stack">
    <button bindtap="export">导出备份到剪贴板</button>
    <view class="caption">备份含本机模型配置，请保存在你信任的位置。</view>
    <button bindtap="toggleImport">恢复备份</button>
    <block wx:if="{{importing}}">
      <textarea
        class="field textarea"
        value="{{backup}}"
        bindinput="backup"
        maxlength="-1"
        placeholder="粘贴备份内容"
      />
      <button class="primary" bindtap="import">确认恢复</button>
    </block>
    <button class="ghost" bindtap="clearCache">清理可再生成的缓存</button>
  </view>
  <view class="card stack">
    <button bindtap="test" loading="{{testing}}" disabled="{{testing}}">
      检测接口连通性
    </button>
    <button bindtap="testModel" disabled="{{testing}}">测试主模型响应</button>
    <button class="ghost" bindtap="domains">复制使用的域名</button>
    <view class="caption">
      检测使用已保存的设置，不会按服务所在地区阻止请求。
    </view>
    <view class="body-text sub">{{testMessage}}</view>
    <view wx:for="{{results}}" wx:key="url" class="diagnostic">
      <view class="row between">
        <text>{{item.name}}{{item.optional ? '（可选）' : ''}}</text>
        <text class="badge">{{item.ok ? '可连接' : '未连接'}}</text>
      </view>
      <view class="caption">{{item.detail}}</view>
    </view>
  </view>
</view>
