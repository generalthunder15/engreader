.memory-time {
  margin: 24rpx 0;
}
.memory-document {
  padding: 30rpx;
}
.markdown {
  display: block;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
  font-size: 28rpx;
  line-height: 1.9;
}
.memory-editor {
  width: 100%;
  box-sizing: border-box;
  min-height: 50vh;
  margin: 28rpx 0;
  font-size: 28rpx;
  line-height: 1.9;
}
.memory-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
}
.memory-actions button {
  flex: 1;
  width: 0;
  margin: 0;
}
.card button {
  margin-top: 20rpx;
}
