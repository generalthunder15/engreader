<view class="page" style="{{themeStyle}}">
  <view class="heading">MEMORY.md</view>
  <view class="sub">
    所有课程共享的用户记忆。对话结束归档后更新，记录你的情况、偏好和学习经历。保存在本机，你可以直接阅读或纠正这份
    Markdown 文档。
  </view>
  <view class="caption memory-time">{{updated}}</view>
  <view wx:for="{{pending}}" wx:key="id" class="card">
    <view>{{item.title}}</view>
    <view class="sub">{{item.error}}</view>
    <button
      class="small"
      bindtap="retry"
      data-id="{{item.id}}"
      disabled="{{busy}}"
    >
      {{busy ? '正在总结…' : '更新归档记忆'}}
    </button>
  </view>
  <view wx:if="{{!editing}}" class="card memory-document">
    <text class="markdown" user-select="{{true}}">
      {{markdown || '归档一次测评或课程后，这里会显示你的记忆文档。'}}
    </text>
  </view>
  <textarea
    wx:else
    class="field memory-editor"
    value="{{draft}}"
    bindinput="input"
    maxlength="16000"
    show-confirm-bar="{{false}}"
    auto-height
    placeholder="# 用户记忆"
  />
  <view class="memory-actions">
    <button wx:if="{{!editing}}" bindtap="edit" disabled="{{busy}}">
      编辑文档
    </button>
    <block wx:else>
      <button bindtap="cancel">取消</button>
      <button class="primary" bindtap="save">保存文档</button>
    </block>
  </view>
</view>
<app-dialog id="app-dialog" style="{{themeStyle}}" />
