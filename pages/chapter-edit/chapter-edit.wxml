<view class="page" style="{{themeStyle}}">
  <image wx:if="{{themeBg}}" class="theme-bg" src="{{themeBg}}" mode="{{themeBgMode}}"></image>
  <view class="page-body">
    <view class="field">
      <view class="label">章节标题</view>
      <input class="input" value="{{title}}" bindinput="onTitle" placeholder="如：Chapter 1 The Beginning" placeholder-class="ph" />
    </view>

    <view class="field">
      <view class="label">章节正文（英文，支持多段）</view>
      <textarea
        class="input content"
        value="{{content}}"
        bindinput="onContent"
        maxlength="-1"
        auto-height
        placeholder="粘贴本章英文正文…"
        placeholder-class="ph"
        show-confirm-bar="{{false}}"
      />
    </view>

    <view class="field">
      <view class="label-row">
        <view class="label">本章单词 / 短语（{{wordCount}}）</view>
        <view class="extract-btn {{extracting ? 'busy' : ''}}" bindtap="extractWords">
          {{extracting ? (extractTip || '提取中…') : 'AI 提取词表'}}
        </view>
      </view>
      <view class="hint">保存章节前必须有词表（学习阶段的章节闯关会用到）。AI 提取后可手动增删改。</view>

      <view class="word-list" wx:if="{{words.length}}">
        <view class="word-row" wx:for="{{words}}" wx:key="index">
          <input class="input w-word" value="{{item.word}}" data-i="{{index}}" data-f="word" bindinput="onWordInput" placeholder="单词/短语" placeholder-class="ph" />
          <input class="input w-meaning" value="{{item.meaning}}" data-i="{{index}}" data-f="meaning" bindinput="onWordInput" placeholder="中文释义" placeholder-class="ph" />
          <view class="w-del" catchtap="removeWordRow" data-i="{{index}}">✕</view>
        </view>
      </view>
      <view class="add-word" bindtap="addWordRow">＋ 手动添加一个词</view>
    </view>

    <view class="save-btn {{saving ? 'busy' : ''}}" bindtap="save">
      {{saving ? saveStep : (isEdit ? '保存章节' : '创建章节')}}
    </view>
    <view class="save-hint" wx:if="{{saving}}">保存时会自动逐句批量翻译并缓存，翻译只在保存时花费一次调用</view>
  </view>
</view>
