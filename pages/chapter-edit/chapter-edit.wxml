<view class="page" style="{{themeStyle}}">
  <view class="eyebrow">MAKE IT YOURS</view>
  <view class="heading">{{editing ? '编辑章节' : '新的阅读篇章'}}</view>
  <view class="sub">正文、词汇、句译，让一篇文章成为你的教材。</view>
  <view class="card">
    <view class="label">章节标题</view>
    <input
      class="field"
      value="{{title}}"
      bindinput="title"
      placeholder="给这一章起个名字"
      disabled="{{busy}}"
    />
    <view class="label">英文正文</view>
    <textarea
      class="field textarea content"
      value="{{content}}"
      bindinput="content"
      placeholder="粘贴你想读的英文内容…"
      maxlength="-1"
      disabled="{{busy}}"
    />
  </view>
  <view class="row between">
    <view class="section-title">本章词表 · {{words.length}}</view>
    <button class="small" bindtap="extract" disabled="{{busy}}">
      AI 提取词表
    </button>
  </view>
  <view class="caption">提取 B1 及以上词汇和常用搭配，也可以手动添加。</view>
  <view class="card">
    <view class="word-row" wx:for="{{words}}" wx:key="index">
      <view class="grow">
        <input
          class="field"
          value="{{item.word}}"
          data-index="{{index}}"
          data-field="word"
          bindinput="word"
          placeholder="英文单词或短语"
          disabled="{{busy}}"
        />
        <input
          class="field meaning"
          value="{{item.meaning}}"
          data-index="{{index}}"
          data-field="meaning"
          bindinput="word"
          placeholder="中文释义"
          disabled="{{busy}}"
        />
      </view>
      <button
        class="icon-button"
        data-index="{{index}}"
        bindtap="removeWord"
        disabled="{{busy}}"
        aria-label="移除词语"
      >
        <app-icon name="close" size="32" />
      </button>
    </view>
    <button class="ghost full" bindtap="addWord" disabled="{{busy}}">
      ＋ 添加词语
    </button>
  </view>
  <view wx:if="{{busy}}" class="loading">{{progress}}</view>
  <view class="sticky-actions">
    <button
      class="primary"
      bindtap="save"
      loading="{{busy}}"
      disabled="{{busy}}"
    >
      保存章节与句译
    </button>
  </view>
</view>
