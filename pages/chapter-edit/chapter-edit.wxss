.content {
  height: 400rpx;
}
.word-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.meaning {
  margin-top: 10rpx;
}
.label:first-child {
  margin-top: 0;
}
.editor-types {
  gap: 12rpx;
  margin: 24rpx 0;
}
.editor-types button {
  flex: 1;
  width: 0;
  min-width: 0;
  margin: 0;
  padding: 20rpx 8rpx;
}
.editor-question {
  border-top: 1rpx solid var(--line);
  margin-top: 24rpx;
  padding-top: 18rpx;
}
.editor-question .field {
  margin-bottom: 16rpx;
}
