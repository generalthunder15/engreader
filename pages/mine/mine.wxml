<view class="page has-tabbar" style="{{themeStyle}}">
  <image wx:if="{{themeBg}}" class="theme-bg" src="{{themeBg}}" mode="{{themeBgMode}}"></image>
  <view class="page-body">
    <view class="head">
      <view class="head-title">我的</view>
    </view>

    <view class="menu">
      <view class="mi" bindtap="go" data-url="/pages/vocab/vocab">
        <view class="mi-ico">📕</view>
        <view class="mi-name">生词本</view>
        <view class="mi-sub">{{stat.vocab}} 个</view>
        <view class="mi-arrow">›</view>
      </view>
      <view class="mi" bindtap="go" data-url="/pages/sentences/sentences">
        <view class="mi-ico">💬</view>
        <view class="mi-name">收藏句子</view>
        <view class="mi-sub">{{stat.sentences}} 句</view>
        <view class="mi-arrow">›</view>
      </view>
      <view class="mi" bindtap="go" data-url="/pages/favorites/favorites">
        <view class="mi-ico">⭐</view>
        <view class="mi-name">收藏文章</view>
        <view class="mi-sub">{{stat.favors}} 章</view>
        <view class="mi-arrow">›</view>
      </view>
      <view class="mi dim">
        <view class="mi-ico">🧠</view>
        <view class="mi-name">收藏知识点</view>
        <view class="mi-sub">敬请期待</view>
        <view class="mi-arrow">›</view>
      </view>
    </view>

    <view class="menu">
      <view class="mi" bindtap="go" data-url="/pages/settings/settings">
        <view class="mi-ico">⚙️</view>
        <view class="mi-name">系统设置</view>
        <view class="mi-sub">API 配置 · 闯关词数 · 备份</view>
        <view class="mi-arrow">›</view>
      </view>
    </view>

    <view class="about">英语精读 v3.0 · 个人单机版</view>
  </view>
</view>
