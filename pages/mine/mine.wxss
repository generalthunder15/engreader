.page { min-height: 100vh; background: var(--c-bg); position: relative; }
.theme-bg { position: fixed; left: 0; top: 0; width: 100vw; height: 100vh; z-index: 0; }
.page-body { position: relative; z-index: 1; padding: 30rpx 30rpx calc(160rpx + env(safe-area-inset-bottom)); }

.head { margin-bottom: 24rpx; }
.head-title { font-size: 44rpx; font-weight: 700; color: var(--c-text-strong); }

.menu { background: var(--c-card); border-radius: var(--r-card); overflow: hidden; margin-bottom: 26rpx; }
.mi { display: flex; align-items: center; padding: 30rpx 28rpx; border-bottom: 1rpx solid var(--c-border); }
.mi:last-child { border-bottom: none; }
.mi.dim { opacity: 0.5; }
.mi-ico { width: 64rpx; font-size: 40rpx; flex-shrink: 0; }
.mi-name { font-size: 30rpx; font-weight: 600; color: var(--c-text); flex: 1; }
.mi-sub { font-size: 24rpx; color: var(--c-text-hint); margin-right: 12rpx; }
.mi-arrow { font-size: 36rpx; color: var(--c-text-faint); }
.about { text-align: center; font-size: 22rpx; color: var(--c-text-faint); margin-top: 40rpx; }
