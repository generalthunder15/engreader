.sec { font-size: 32rpx; font-weight: 500; margin-bottom: 24rpx; color: var(--c-text, #1A1D24); }
.field { margin-bottom: 22rpx; }
.label { font-size: 26rpx; color: var(--c-text-muted, #6B7280); margin-bottom: 10rpx; }
.ipt { background: var(--c-bg, #F6F7F9); border-radius: var(--r-sm, 12rpx); padding: 18rpx 22rpx; font-size: 28rpx; color: var(--c-text, #1A1D24); }
.ph { color: var(--c-text-faint, #C3C8D0); }
.field.row { display: flex; align-items: center; justify-content: space-between; }
.field.row .label { margin-bottom: 0; }
.hint { font-size: 24rpx; color: var(--c-text-hint, #9AA0AA); line-height: 1.7; margin-top: 20rpx; }

.stat { font-size: 26rpx; color: var(--c-text-muted, #6B7280); margin-bottom: 20rpx; }
.row-btns { display: flex; gap: 20rpx; margin-bottom: 20rpx; }
.row-btns .btn-plain { flex: 1; font-size: 26rpx; padding: 14rpx 0; }
.danger { color: var(--c-danger-strong, #A32D2D); border-color: var(--c-danger-strong, #A32D2D); }
.ta {
  width: 100%; box-sizing: border-box; height: 260rpx;
  background: var(--c-bg, #F6F7F9); border-radius: var(--r-sm, 12rpx); padding: 20rpx;
  font-size: 24rpx; line-height: 1.6; margin-bottom: 20rpx; color: var(--c-text, #1A1D24);
}
.about { text-align: center; color: var(--c-text-faint, #C3C8D0); font-size: 24rpx; padding: 30rpx 0 60rpx; }
