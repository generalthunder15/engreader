.stats {
  display: flex;
  justify-content: space-around;
  text-align: center;
  padding: 38rpx 16rpx;
}
.stats .caption {
  margin-top: 8rpx;
}
.menu {
  padding: 8rpx 25rpx;
}
.menu-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  background: var(--soft);
  display: flex;
  align-items: center;
  justify-content: center;
}
.list-row .caption {
  margin-top: 7rpx;
}
.about {
  text-align: center;
  color: var(--muted);
  font-size: 22rpx;
  margin-top: 50rpx;
  letter-spacing: 2rpx;
}
