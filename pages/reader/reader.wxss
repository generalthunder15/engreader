@import "../../app.wxss";
.reader {
  min-height: 100vh;
  background: var(--bg);
  color: var(--text);
  font-family: var(--font-ui);
  padding-bottom: 100rpx;
}
.reader-head {
  padding: 40rpx 42rpx 0;
}
.reader-head .eyebrow {
  letter-spacing: 2rpx;
  margin-right: 160rpx;
}
.reader-head .caption {
  font-size: 20rpx;
  margin-top: 20rpx;
}
.reading-content {
  padding: 0 42rpx;
}
.chapter-anchor {
  padding-top: 70rpx;
  padding-bottom: 35rpx;
}
.chapter-title {
  font-size: 45rpx;
  line-height: 1.5;
  font-weight: 550;
  font-family: var(--font-read);
}
.chapter-rule {
  width: 65rpx;
  height: 4rpx;
  background: var(--primary);
  margin-top: 28rpx;
}
.paragraph {
  margin: 12rpx 0 30rpx;
}
.english {
  font-size: var(--read-size, 36rpx);
  line-height: var(--read-line, 2.1);
  font-family: var(--font-read, Georgia, serif);
  text-indent: var(--read-indent, 34rpx);
  word-break: normal;
  overflow-wrap: break-word;
  white-space: normal;
}
.token {
  display: inline;
  border-radius: 4rpx;
}
.token.marked {
  border-bottom: 3rpx solid #c4a25a;
  background: rgba(196, 162, 90, 0.14);
}
.token.selected {
  background: var(--primary);
  color: var(--on-primary);
}
.sentence-translation {
  font-size: 26rpx;
  line-height: 1.9;
  color: var(--muted);
  padding: 14rpx 0 5rpx;
  text-indent: 0;
}
/* Inline annotation marker stays in the text flow, before its translation. */
.note-bubble {
  display: inline-flex;
  position: relative;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-width: 46rpx;
  height: 32rpx;
  padding: 0 10rpx;
  margin: 0 12rpx 0 10rpx;
  vertical-align: middle;
  transform: translateY(-3rpx);
  border: 2rpx solid currentColor;
  border-radius: 18rpx;
  color: var(--muted);
  background: var(--bg);
  font-family: var(--font-ui);
  font-size: 19rpx;
  font-weight: 400;
  line-height: 1;
  text-indent: 0;
  white-space: nowrap;
}
.note-bubble::after {
  content: "";
  position: absolute;
  left: 8rpx;
  bottom: -6rpx;
  width: 9rpx;
  height: 9rpx;
  background: var(--bg);
  border-left: 2rpx solid currentColor;
  border-bottom: 2rpx solid currentColor;
  transform: skewY(-32deg);
}
.note-count { position: relative; z-index: 1; }
.note-pencil {
  position: absolute;
  top: -9rpx;
  right: -3rpx;
  width: 7rpx;
  height: 17rpx;
  border-radius: 2rpx 2rpx 0 0;
  background: currentColor;
  transform: rotate(40deg);
  box-shadow: 0 0 0 3rpx var(--bg);
}
.note-pencil::after {
  content: "";
  position: absolute;
  bottom: -5rpx;
  left: 0;
  border-left: 3.5rpx solid transparent;
  border-right: 3.5rpx solid transparent;
  border-top: 5rpx solid currentColor;
}
.reading-end {
  text-align: center;
  font-size: 23rpx;
  color: var(--muted);
  padding: 50rpx 0;
}
.load-more {
  margin: 0 80rpx;
}
.reader-top {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  background: var(--card);
  z-index: 60;
  display: flex;
  align-items: center;
  padding-right: 190rpx;
  box-sizing: content-box;
  min-height: 76rpx;
  border-bottom: 1rpx solid var(--line);
}
.top-title {
  flex: 1;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 25rpx;
}
.reader-controls {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 22rpx calc(22rpx + env(safe-area-inset-bottom));
  background: var(--card);
  z-index: 60;
  box-shadow: 0 -4rpx 30rpx rgba(0, 0, 0, 0.06);
  border-radius: 28rpx 28rpx 0 0;
}
.reader-tools {
  display: flex;
  justify-content: space-around;
}
.reader-tools button {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  background: transparent;
  font-size: 22rpx;
  font-weight: 400;
  padding: 14rpx;
}
.selection-bar {
  position: fixed;
  top: 0;
  left: 12px;
  width: calc(100vw - 24px);
  max-width: 480px;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  padding: 6px;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.14);
  z-index: 65;
}
.selection-hidden {
  visibility: hidden;
  pointer-events: none;
}
.selection-arrow {
  position: absolute;
  width: 12px;
  height: 12px;
  background: var(--card);
  transform: translateX(-50%) rotate(45deg);
}
.selection-bar.below .selection-arrow {
  top: -6px;
  border-top: 1rpx solid var(--line);
  border-left: 1rpx solid var(--line);
}
.selection-bar.above .selection-arrow {
  bottom: -6px;
  border-bottom: 1rpx solid var(--line);
  border-right: 1rpx solid var(--line);
}
.selection-actions {
  white-space: nowrap;
  width: 100%;
}
.selection-action {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 60px;
  height: 52px;
  vertical-align: top;
  gap: 8rpx;
  background: transparent;
  font-size: 12px;
  line-height: 1.4;
  padding: 6px 4px;
  font-weight: 400;
}
.selection-action-hover {
  background: var(--soft);
  border-radius: 12rpx;
}
.toc-current {
  color: var(--primary);
  font-weight: 600;
  background: var(--soft);
  padding-left: 18rpx;
  padding-right: 18rpx;
  border-radius: 14rpx;
}
.panel-tabs {
  flex: 1;
  min-width: 0;
  flex-wrap: nowrap;
  gap: 6rpx;
}
.panel-tabs .chip {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  min-width: 0;
  white-space: nowrap;
  min-height: 64rpx;
  line-height: 1.4;
  font-size: 22rpx;
  padding: 13rpx 0;
}
.analysis-sheet {
  padding-left: 25rpx;
  padding-right: 25rpx;
}
.analysis-sheet .sheet-head .icon-button {
  width: 64rpx;
  height: 64rpx;
  margin: 0 0 0 8rpx;
  padding: 0;
}
.definition {
  font-size: 34rpx;
  line-height: 1.8;
  margin: 25rpx 0 16rpx;
}
.panel-actions {
  margin: 30rpx 0;
}
.panel-actions button.small {
  width: auto;
  min-width: 0;
  flex: 1;
  margin: 0;
  padding: 15rpx 8rpx;
  white-space: nowrap;
}
.question-chips {
  margin: 22rpx 0;
}
.ask-button {
  margin-top: 20rpx;
}
.answer {
  padding: 28rpx 0;
}
.analysis-sheet .quote {
  font-size: 29rpx;
}
