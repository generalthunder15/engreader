<view class="page" style="{{themeStyle}}">
  <image wx:if="{{themeBg}}" class="theme-bg" src="{{themeBg}}" mode="{{themeBgMode}}"></image>

  <!-- 自定义顶栏（小说式沉浸）：返回 + 章节名/进度 + 收藏 -->
  <view class="topbar {{ctl.show ? 'on' : ''}}" style="padding-top:{{statusBarH}}px" wx:if="{{ctl.show}}">
    <view class="tb-back" bindtap="onBack">‹</view>
    <view class="tb-mid">
      <view class="tb-title">{{article.title}}</view>
      <view class="tb-sub">{{book.title}} · {{chIndex + 1}}/{{chTotal}} · {{progressPct}}%</view>
    </view>
    <view class="tb-fav {{favored ? 'on' : ''}}" bindtap="toggleFavor">{{favored ? '★' : '☆'}}</view>
  </view>

  <view class="page-body">
  <view class="reader" style="padding-top:{{statusBarH + 12}}px">
  <view class="art-title">{{article.title}}</view>

  <view class="paragraph" wx:for="{{paragraphs}}" wx:key="pid" wx:for-item="para">
    <text class="indent"></text>
    <block wx:for="{{para.tokens}}" wx:key="id" wx:for-item="tk">
      <text
        id="tok-{{tk.id}}"
        class="tok {{marksMap[tk.id] ? 'marked' : ''}} {{spaceMarks[tk.id] ? 'mark-cont' : ''}} {{tk.id >= selStart && tk.id <= selEnd ? 'sel' : ''}} {{tk.id >= selStart && tk.id < selEnd ? 'sel-cont' : ''}}"
        data-id="{{tk.id}}"
        bindtouchstart="onTouchStart"
        bindtouchend="onTouchEnd"
        bindlongpress="onLongPress"
      >{{tk.w}}</text>
      <text
        wx:if="{{tk.sp}}"
        class="sp"
        data-id="{{tk.id}}"
        bindtouchstart="onTouchStart"
        bindtouchend="onTouchEnd"
        bindlongpress="onLongPress"
      ></text>
    </block>
    <view
      wx:if="{{noteCounts[para.pid]}}"
      class="note-badge"
      data-pid="{{para.pid}}"
      catchtap="onNoteBadge"
    >{{noteCounts[para.pid]}}</view>
    <!-- 句译：保存章节时批量翻译并缓存，这里零成本展示 -->
    <view class="para-trans" wx:if="{{showTrans && transMap[para.pid]}}">{{transMap[para.pid]}}</view>
  </view>

  <view class="reader-foot-tip">双击选词 · 长按选整句 · 单击呼出菜单</view>
</view>

<!-- 底部控制条（小说式）：上一章/进度/下一章 + 目录/夜间/设置/翻译 -->
<view class="ctlbar {{ctl.show ? 'on' : ''}}" wx:if="{{ctl.show}}">
  <view class="ctl-nav">
    <view class="ctl-nav-btn {{chIndex <= 0 ? 'dim' : ''}}" bindtap="prevChapter">上一章</view>
    <slider
      class="ctl-slider"
      min="0"
      max="{{chTotal - 1}}"
      value="{{chIndex}}"
      activeColor="{{themePrimary}}"
      block-size="20"
      bindchange="onSlider"
    />
    <view class="ctl-nav-btn {{chIndex >= chTotal - 1 ? 'dim' : ''}}" bindtap="nextChapter">下一章</view>
  </view>
  <view class="ctl-menu">
    <view class="ctl-item" bindtap="openToc">
      <view class="ctl-ico">☰</view>
      <view class="ctl-txt">目录</view>
    </view>
    <view class="ctl-item" bindtap="toggleNight">
      <view class="ctl-ico">{{rsTheme === 'night' ? '☀' : '☾'}}</view>
      <view class="ctl-txt">{{rsTheme === 'night' ? '白天' : '夜间'}}</view>
    </view>
    <view class="ctl-item" bindtap="openRS">
      <view class="ctl-ico">⚙</view>
      <view class="ctl-txt">设置</view>
    </view>
    <view class="ctl-item" bindtap="toggleTrans">
      <view class="ctl-ico {{showTrans ? 'on' : ''}}">译</view>
      <view class="ctl-txt">{{showTrans ? '关句译' : '显示翻译'}}</view>
    </view>
  </view>
</view>

<!-- 目录抽屉 -->
<view class="toc-wrap" wx:if="{{toc.show}}" catchtouchmove="noop">
  <view class="toc-mask" bindtap="closeToc"></view>
  <view class="toc-panel">
    <view class="toc-head">
      <view class="toc-title">{{book.title}}</view>
      <view class="toc-close" bindtap="closeToc">✕</view>
    </view>
    <scroll-view scroll-y class="toc-body" scroll-into-view="toc-cur">
      <view
        wx:for="{{toc.list}}"
        wx:key="id"
        id="{{toc.current === item.id ? 'toc-cur' : ''}}"
        class="toc-item {{toc.current === item.id ? 'on' : ''}}"
        bindtap="pickChapter"
        data-id="{{item.id}}"
      >
        <text class="toc-idx">{{item.idx}}</text>
        <text class="toc-name">{{item.title}}</text>
      </view>
    </scroll-view>
  </view>
</view>

<!-- 段落笔记弹层 -->
<view class="np-wrap" wx:if="{{noteView.show}}" catchtouchmove="noop">
  <view class="np-mask" bindtap="closeNoteView"></view>
  <view class="np-panel">
    <view class="np-head">
      <view class="np-tabs">
        <view class="np-tab">本段笔记 · {{noteView.list.length}}</view>
      </view>
      <view class="np-close" bindtap="closeNoteView">✕</view>
    </view>

    <scroll-view scroll-y class="np-body">
      <view class="np-sel">{{noteView.paraText}}</view>
      <view class="np-item" wx:for="{{noteView.list}}" wx:key="createdAt">
        <view class="np-note">{{item.note}}</view>
        <view class="np-meta">
          <text class="np-time">{{item.timeText}}</text>
          <text class="np-del" data-idx="{{index}}" catchtap="delParaNote">删除</text>
        </view>
      </view>
      <view class="np-hint" wx:if="{{!noteView.list.length}}">本段还没有笔记</view>
    </scroll-view>

    <view class="np-foot">
      <view class="np-btn" bindtap="closeNoteView">关闭</view>
    </view>
  </view>
</view>

<!-- 阅读设置抽屉 -->
<view class="rs-wrap" wx:if="{{rs.show}}" catchtouchmove="noop">
  <view class="rs-mask" bindtap="closeRS"></view>
  <view class="rs-panel">
    <view class="rs-head">
      <view class="rs-tabs"><view class="rs-tab">阅读设置</view></view>
      <view class="rs-close" bindtap="closeRS">✕</view>
    </view>

    <scroll-view scroll-y class="rs-body">
      <view class="rs-sec">主题</view>
      <view class="rs-theme-list">
        <view
          class="rs-theme-item {{rsTheme === item.id ? 'on' : ''}}"
          wx:for="{{rsThemes}}"
          wx:key="id"
          bindtap="pickTheme"
          data-id="{{item.id}}"
        >
          <image class="rs-theme-cover" src="{{item.cover}}" mode="aspectFill"></image>
          <view class="rs-theme-name">{{item.name}}</view>
          <view class="rs-check" wx:if="{{rsTheme === item.id}}">✓</view>
        </view>
      </view>

      <view class="rs-sec">阅读字体</view>
      <scroll-view class="rs-font-scroll" scroll-x enable-flex>
        <view
          class="rs-font-item {{rsFont === item.id ? 'on' : ''}}"
          wx:for="{{rsFonts}}"
          wx:key="id"
          bindtap="pickFont"
          data-id="{{item.id}}"
        >
          <view class="rs-font-sample" style="font-family:{{item.css}}">Aa Bb</view>
          <view class="rs-font-name">{{item.name}}</view>
          <view class="rs-font-meta">{{item.metaText}}</view>
          <view
            class="rs-font-del"
            wx:if="{{item.kind === 'custom'}}"
            catchtap="removeFont"
            data-id="{{item.id}}"
            data-name="{{item.name}}"
          >✕</view>
        </view>
      </scroll-view>

      <view class="rs-field">
        <view class="rs-label">阅读字号 · 当前 {{rsEff.size}}rpx</view>
        <view class="rs-seg">
          <view class="rs-seg-item {{rsEff.size === item.v ? 'on' : ''}}" wx:for="{{sizeOptions}}" wx:key="v" data-v="{{item.v}}" bindtap="setSize">{{item.t}}</view>
        </view>
      </view>
      <view class="rs-field">
        <view class="rs-label">行距 · 当前 {{rsEff.line}}</view>
        <view class="rs-seg">
          <view class="rs-seg-item {{rsEff.line === item.v ? 'on' : ''}}" wx:for="{{lineOptions}}" wx:key="v" data-v="{{item.v}}" bindtap="setLine">{{item.t}}</view>
        </view>
      </view>
      <view class="rs-field rs-row">
        <view class="rs-label">首行缩进两个字母</view>
        <switch checked="{{rsEff.indent}}" color="{{themePrimary}}" bindchange="onIndent" />
      </view>
      <view class="rs-field rs-row">
        <view class="rs-label">字体同时用到界面文字</view>
        <switch checked="{{rsUiSame}}" color="{{themePrimary}}" bindchange="onUiSame" />
      </view>
      <view class="btn-plain rs-import" bindtap="importFont">导入字体包（.ttf / .otf）</view>
      <view class="rs-hint">主题、字体、排版设置全局生效并自动保存。中文字体（如霞鹜文楷）体积较大，用「导入字体包」从微信聊天记录安装，不占小程序包体。</view>
    </scroll-view>
  </view>
</view>

<selection-toolbar
  style="{{themeStyle}}"
  show="{{bar.show}}"
  left="{{bar.left}}"
  top="{{bar.top}}"
  bindaction="onBarAction"
/>

<ai-panel
  style="{{themeStyle}}"
  show="{{panel.show}}"
  loading="{{panel.loading}}"
  type="{{panel.type}}"
  tab="{{panel.tab}}"
  result="{{panel.result}}"
  detailResult="{{panel.detailResult}}"
  detailLoading="{{panel.detailLoading}}"
  qaLoading="{{panel.qaLoading}}"
  qaResult="{{panel.qaResult}}"
  qSuggestions="{{panel.qaSuggestions}}"
  playing="{{panel.playing}}"
  selectedText="{{selectedText}}"
  bindtabchange="onPanelTab"
  bindclose="onPanelClose"
  bindplay="onPanelPlay"
  bindstop="onPanelStop"
  bindaddvocab="onAddVocab"
  bindretry="onPanelRetry"
  binddetail="onPanelDetail"
  bindspeak="onPanelSpeak"
  bindask="onPanelAsk"
  bindsavenote="onSaveNote"
/>
  </view>
</view>
