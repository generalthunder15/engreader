<view class="reader" style="{{themeStyle}}">
  <view class="reader-status-cover" style="height:{{statusHeight}}px" aria-hidden="true"></view>
  <article-chat hidden="{{!chapterId || panel || notesOpen || toc}}" book-id="{{readerBookId}}" chapter-id="{{chapterId}}" />
  <view class="reader-head" style="padding-top:{{statusHeight + 14}}px">
    <view class="eyebrow">{{book.title}}</view>
    <view class="caption">双击选词 · 长按选句 · 横向拖选 · 轻点显示菜单</view>
  </view>
  <app-exam
    wx:if="{{examChapter}}"
    book-id="{{readerBookId}}"
    chapter-id="{{examChapter}}"
    selection-key="{{examSelectionKey}}"
    bind:readtap="toggleControls"
    bind:selection="selectExamText"
  />
  <view
    wx:if="{{!examChapter}}"
    class="reading-content"
    bindtap="toggleControls"
  >
    <block wx:for="{{blocks}}" wx:key="uid" wx:for-item="block">
      <view
        wx:if="{{block.type === 'title'}}"
        class="chapter-anchor"
        id="{{block.uid}}"
      >
        <view class="chapter-title">{{block.text}}</view>
        <view class="chapter-rule"></view>
      </view>
      <view wx:else class="paragraph">
        <!-- prettier-ignore -->
        <view class="english"><block wx:for="{{block.tokens}}" wx:key="globalId" wx:for-item="token"><text id="tok-{{token.globalId}}" class="token {{token.marked ? 'marked' : ''}} {{token.selected ? 'selected' : ''}}" data-token="{{token.globalId}}" catchtap="noop" bindtouchstart="touchStart" bindtouchmove="touchMove" bindtouchend="touchEnd" bindlongpress="hold">{{token.w}}</text><text>{{token.after}}</text></block><view wx:if="{{block.notes.length}}" class="note-bubble" catchtap="openNotes" data-uid="{{block.uid}}" aria-role="button" aria-label="查看 {{block.notes.length}} 条笔记"><text class="note-count">{{block.notes.length}}</text><view class="note-pencil"></view></view></view>
        <view
          wx:if="{{showTrans && block.translation}}"
          class="sentence-translation"
        >
          {{block.translation}}
        </view>

      </view>
    </block>
  </view>
  <view wx:if="{{!examChapter}}" class="reading-end">
    {{hasMore ? '继续上滑，阅读下一章' : '已读至本书末尾'}}
  </view>
  <button wx:if="{{hasMore}}" class="load-more" bindtap="onReachBottom">
    加载下一章
  </button>
  <view
    class="reader-top"
    wx:if="{{controls}}"
    style="padding-top:{{statusHeight}}px"
  >
    <button class="icon-button" bindtap="back" aria-label="返回">
      <app-icon name="back" />
    </button>
    <text class="top-title">{{chapterTitle}}</text>
    <button class="icon-button" bindtap="favorite" aria-label="收藏章节">
      <app-icon name="{{favored ? 'check' : 'bookmark'}}" />
    </button>
  </view>
  <view class="reader-controls" wx:if="{{controls}}">
    <view class="row between">
      <button class="small ghost" bindtap="previous">上一章</button>
      <text class="caption">{{index + 1}} / {{total}} · {{percent}}%</text>
      <button class="small ghost" bindtap="next">下一章</button>
    </view>
    <slider
      min="0"
      max="{{total > 1 ? total - 1 : 1}}"
      value="{{index}}"
      disabled="{{total < 2}}"
      bindchange="slider"
      activeColor="{{themePrimary}}"
    />
    <view class="reader-tools">
      <button bindtap="showToc">
        <app-icon name="list" />
        <text>目录</text>
      </button>
      <button bindtap="translation">
        <app-icon name="translate" />
        <text>{{showTrans ? '隐藏句译' : '句译'}}</text>
      </button>
      <button bindtap="night">
        <app-icon name="moon" />
        <text>{{themeId === 'night' ? '日间' : '夜间'}}</text>
      </button>
      <button bindtap="quiz">
        <app-icon name="spark" />
        <text>闯关</text>
      </button>
      <button bindtap="settings">
        <app-icon name="settings" />
        <text>设置</text>
      </button>
    </view>
  </view>
  <view
    class="selection-bar {{toolbarReady ? '' : 'selection-hidden'}} {{toolbarSide}}"
    style="{{toolbarStyle}}"
    wx:if="{{toolbar}}"
    catchtap="noop"
  >
    <view class="selection-arrow" style="left:{{toolbarArrow}}px"></view>
    <scroll-view scroll-x class="selection-actions" show-scrollbar="{{false}}">
      <view
        class="selection-action"
        aria-role="button"
        hover-class="selection-action-hover"
        wx:for="{{actions}}"
        wx:key="id"
        wx:if="{{(!selectedIsWord || item.id !== 'favorite') && (!examChapter || item.id !== 'mark')}}"
        data-action="{{item.id}}"
        bindtap="action"
      >
        <app-icon name="{{item.icon}}" size="34" />
        <text>{{item.text}}</text>
      </view>
      <view
        class="selection-action"
        aria-role="button"
        hover-class="selection-action-hover"
        bindtap="clearSelection"
      >
        <app-icon name="close" size="34" />
        <text>取消</text>
      </view>
    </scroll-view>
  </view>
  <block wx:if="{{toc}}">
    <view class="mask" bindtap="closeToc"></view>
    <view class="sheet">
      <view class="sheet-head">
        <text>章节目录</text>
        <button class="icon-button" bindtap="closeToc" aria-label="关闭目录">
          <app-icon name="close" />
        </button>
      </view>
      <scroll-view scroll-y class="sheet-scroll">
        <view
          wx:for="{{book.chapters}}"
          wx:key="id"
          class="list-row {{chapterId === item.id ? 'toc-current' : ''}}"
          data-id="{{item.id}}"
          bindtap="pickChapter"
        >
          <text class="caption">{{index + 1}}</text>
          <text class="grow">{{item.title}}</text>
          <button wx:if="{{item.examId}}" class="small toc-exam" data-id="{{item.examId}}" catchtap="pickChapter">试卷</button>
          <app-icon wx:if="{{chapterId === item.id}}" name="check" size="30" />
        </view>
      </scroll-view>
    </view>
  </block>
  <block wx:if="{{panel}}">
    <view class="mask" bindtap="closePanel"></view>
    <view class="sheet analysis-sheet">
      <view class="sheet-head">
        <view class="chips panel-tabs">
          <view
            aria-role="button"
            class="chip {{tab === 'translation' ? 'active' : ''}}"
            data-tab="translation"
            bindtap="tab"
          >
            释义
          </view>
          <view
            aria-role="button"
            class="chip {{tab === 'grammar' ? 'active' : ''}}"
            wx:if="{{!selectedIsWord}}"
            data-tab="grammar"
            bindtap="tab"
          >
            语法
          </view>
          <view
            aria-role="button"
            class="chip {{tab === 'detail' ? 'active' : ''}}"
            data-tab="detail"
            bindtap="tab"
          >
            拆解
          </view>
          <view
            aria-role="button"
            class="chip {{tab === 'ask' ? 'active' : ''}}"
            data-tab="ask"
            bindtap="tab"
          >
            提问
          </view>
          <view
            aria-role="button"
            class="chip {{tab === 'note' ? 'active' : ''}}"
            data-tab="note"
            bindtap="tab"
          >
            笔记
          </view>
        </view>
        <button
          class="icon-button"
          bindtap="closePanel"
          aria-label="关闭精读面板"
        >
          <app-icon name="close" size="32" />
        </button>
      </view>
      <scroll-view scroll-y class="sheet-scroll">
        <view class="quote">{{selectedText}}</view>
        <view wx:if="{{busy}}" class="loading">正在分析，请稍候…</view>
        <view wx:if="{{panelError}}" class="error">{{panelError}}</view>
        <block wx:if="{{tab === 'translation'}}">
          <view wx:if="{{definition}}">
            <view class="definition">{{definition.translation}}</view>
            <view class="caption">
              {{definition.phonetic}} {{definition.pos}}
            </view>
            <view class="badge" wx:if="{{definition.source === 'offline'}}">
              内置离线释义
            </view>
            <view class="sub" wx:for="{{definition.senses}}" wx:key="index">
              {{item}}
            </view>
            <view wx:if="{{definition.example}}" class="card">
              <text class="body-text">{{definition.example}}</text>
              <view class="caption">{{definition.exampleTranslation}}</view>
            </view>
          </view>
          <view class="row wrap panel-actions">
            <button class="small" bindtap="play">
              {{playing ? '停止朗读' : '朗读'}}
            </button>
            <button class="small" bindtap="addVocab" disabled="{{!definition}}">
              加入生词本
            </button>
            <button wx:if="{{panelError}}" class="small" bindtap="retryTranslation" disabled="{{busy}}">
              重试
            </button>
          </view>
        </block>
        <block wx:elif="{{tab === 'grammar'}}">
          <block wx:if="{{definition.grammar}}">
            <view class="section-title">句子主干</view>
            <text class="body-text">{{definition.grammar.structure}}</text>
            <view
              wx:for="{{definition.grammar.clauses}}"
              wx:key="index"
              class="card"
            >
              <view class="badge">{{item.type}}</view>
              <view class="sub">{{item.text}}</view>
              <text class="body-text">{{item.explain}}</text>
            </view>
            <view
              class="card"
              wx:for="{{definition.grammar.phrases}}"
              wx:key="index"
            >
              <view>{{item.text}}</view>
              <view class="sub">{{item.explain}}</view>
            </view>
            <view class="sub">{{definition.grammar.difficultPoints}}</view>
          </block>
          <view wx:else class="empty">
            <view class="sub">点击 AI 精解，了解句子结构。</view>
            <button bindtap="retry" disabled="{{busy}}">AI 精解</button>
          </view>
        </block>
        <block wx:elif="{{tab === 'detail'}}">
          <block wx:if="{{detail}}">
            <view class="definition">{{detail.translation}}</view>
            <view class="sub">{{detail.structure}}</view>
            <block wx:if="{{detail.kind === 'word' && detail.roots}}"><view class="section-title">词根与词缀</view><view class="body-text">{{detail.roots}}</view></block>
            <view class="section-title">{{detail.kind === 'word' ? '词形变化' : '重点词汇'}}</view>
            <view wx:for="{{detail.words}}" wx:key="index" class="list-row">
              <view class="grow">
                <view>{{item.word}} · {{item.meaning}}</view>
                <view class="caption">{{item.note}}</view>
              </view>
              <button
                class="icon-button"
                data-text="{{item.word}}"
                bindtap="speakText"
                aria-label="朗读词语"
              >
                <app-icon name="volume" size="32" />
              </button>
            </view>
            <view class="section-title">短语与搭配</view>
            <view wx:for="{{detail.phrases}}" wx:key="index" class="card">
              <view class="row">
                <text class="grow">{{item.text}}</text>
                <button
                  class="icon-button"
                  data-text="{{item.text}}"
                  bindtap="speakText"
                  aria-label="朗读短语"
                >
                  <app-icon name="volume" size="30" />
                </button>
              </view>
              <view class="sub">{{item.meaning}}</view>
              <view class="caption">{{item.usage}}</view>
            </view>
            <view wx:if="{{detail.kind !== 'word'}}" class="section-title">语法要点</view>
            <view wx:for="{{detail.kind === 'word' ? [] : detail.grammar}}" wx:key="index" class="card">
              <view>{{item.point}}</view>
              <view class="sub">{{item.explain}}</view>
              <view
                class="quote"
                wx:if="{{item.example}}"
                data-text="{{item.example}}"
                bindtap="speakText"
              >
                {{item.example}}
              </view>
            </view>
            <block wx:if="{{detail.kind === 'word'}}">
              <view wx:if="{{detail.confusions.length}}" class="section-title">易混词辨析</view>
              <view wx:for="{{detail.confusions}}" wx:key="index" class="card"><view>{{item.word}}</view><view class="sub">{{item.difference}}</view><view class="quote" wx:if="{{item.example}}">{{item.example}}</view></view>
              <view wx:if="{{detail.memory}}" class="section-title">记忆方法</view><view class="body-text">{{detail.memory}}</view>
            </block>
            <view class="sub">{{detail.summary}}</view>
          </block>
          <button wx:if="{{!detail && !busy}}" data-tab="detail" bindtap="tab">
            生成详细拆解
          </button>
        </block>
        <block wx:elif="{{tab === 'ask'}}">
          <view class="chips question-chips">
            <button
              wx:for="{{suggestions}}"
              wx:key="index"
              class="chip"
              data-text="{{item}}"
              bindtap="suggestion"
              disabled="{{busy}}"
            >
              {{item}}
            </button>
          </view>
          <textarea show-confirm-bar="{{false}}"
            class="field textarea"
            value="{{question}}"
            data-key="question"
            bindinput="field"
            placeholder="针对原文写下你的问题…"
            maxlength="1000"
          />
          <button
            class="primary full ask-button"
            bindtap="ask"
            disabled="{{busy || !question}}"
          >
            向 AI 提问
          </button>
          <view class="body-text answer" wx:if="{{answer}}">
            <text user-select>{{answer}}</text>
          </view>
        </block>
        <block wx:elif="{{tab === 'note'}}">
          <view class="spacer"></view>
          <textarea show-confirm-bar="{{false}}"
            class="field textarea"
            value="{{note}}"
            data-key="note"
            bindinput="field"
            placeholder="记下你的理解，原文会一同保存。"
            maxlength="2000"
          />
          <button class="primary full ask-button" bindtap="saveNote">
            保存笔记
          </button>
        </block>
      </scroll-view>
    </view>
  </block>
  <block wx:if="{{notesOpen}}">
    <view class="mask" bindtap="closeNotes"></view>
    <view class="sheet notes-sheet">
      <view class="sheet-head">
        <text>阅读笔记</text>
        <button class="icon-button" bindtap="closeNotes" aria-label="关闭笔记">
          <app-icon name="close" />
        </button>
      </view>
      <scroll-view scroll-y class="sheet-scroll">
        <view class="card note-card" wx:for="{{noteList}}" wx:key="createdAt" data-time="{{item.createdAt}}" bindlongpress="noteMenu">
          <view class="note-source">{{item.sel}}</view>
          <block wx:if="{{editingNote === item.createdAt}}">
            <textarea class="field textarea" value="{{noteDraft}}" bindinput="noteDraftInput" maxlength="2000" show-confirm-bar="{{false}}" />
            <view class="row"><button class="small" bindtap="cancelNoteEdit">取消</button><button class="small primary" bindtap="saveNoteEdit">保存</button></view>
          </block>
          <view wx:else class="note-content">{{item.note}}</view>
        </view>
        <view wx:if="{{!noteList.length}}" class="empty">笔记已删除</view>
      </scroll-view>
    </view>
  </block>
</view>

<app-dialog id="app-dialog" style="{{themeStyle}}" />
