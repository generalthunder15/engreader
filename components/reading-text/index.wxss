.reading-paragraph { white-space: pre-wrap; overflow-wrap: break-word; margin-bottom: 1em; }
.reading-paragraph:last-child { margin-bottom: 0; }
.indented { text-indent: 2ch; }
.reading-token { display: inline; border-radius: 4rpx; }
.chosen { background: var(--primary); color: var(--on-primary); }
