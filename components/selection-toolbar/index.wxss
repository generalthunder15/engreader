.mask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  z-index: 90;
}
.bar {
  position: fixed;
  z-index: 91;
  display: flex;
  align-items: center;
  background: var(--c-toolbar-bg, #1F2430);
  border-radius: 12rpx;
  padding: 6rpx 10rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.25);
  font-family: var(--font-ui);
}
.item {
  color: var(--c-toolbar-text, #fff);
  font-size: 26rpx;
  padding: 12rpx 20rpx;
  position: relative;
}
.item + .item::before {
  content: '';
  position: absolute;
  left: 0;
  top: 14rpx;
  bottom: 14rpx;
  width: 1rpx;
  background: var(--c-toolbar-line, rgba(255, 255, 255, 0.18));
}
