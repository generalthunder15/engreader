.wrap { position: fixed; left: 0; top: 0; right: 0; bottom: 0; z-index: 100; font-family: var(--font-ui); }
.mask { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background: var(--c-mask, rgba(0,0,0,0.35)); }
.panel {
  position: absolute; left: 0; right: 0; bottom: 0;
  height: 70vh;
  background: var(--c-card, #fff);
  border-radius: var(--r-sheet, 28rpx) var(--r-sheet, 28rpx) 0 0;
  display: flex; flex-direction: column;
}
.head {
  display: flex; align-items: center; justify-content: space-between;
  padding: 20rpx 28rpx 0;
  border-bottom: 1rpx solid var(--c-border, #F0F1F4);
}
.tabs { display: flex; }
.tab {
  font-size: 30rpx; color: var(--c-text-muted, #6B7280); padding: 16rpx 26rpx;
  position: relative;
}
.tab.on { color: var(--c-primary, #2B6CB0); font-weight: 500; }
.tab.on::after {
  content: ''; position: absolute; left: 50%; transform: translateX(-50%);
  bottom: 6rpx; width: 40rpx; height: 6rpx; border-radius: 3rpx; background: var(--c-primary, #2B6CB0);
}
.close { font-size: 36rpx; color: var(--c-text-hint, #9AA0AA); padding: 10rpx 16rpx; }
/* 关键：scroll-view 需要 height:0 + flex:1 才能获得确定的弹性高度，否则内容溢出且无法滚动 */
.body { flex: 1; height: 0; padding: 24rpx 32rpx 140rpx; box-sizing: border-box; }

.sel-text {
  background: var(--c-primary-quote, #F3F6FB); color: var(--c-primary, #2B6CB0);
  border-left: 6rpx solid var(--c-primary, #2B6CB0);
  border-radius: 8rpx; padding: 18rpx 22rpx;
  font-size: 28rpx; line-height: 1.7; margin-bottom: 28rpx;
}
.loading { text-align: center; color: var(--c-text-hint, #9AA0AA); padding: 80rpx 0; font-size: 28rpx; }
.spin {
  width: 44rpx; height: 44rpx; margin: 0 auto 20rpx;
  border: 5rpx solid var(--c-border, #E5EAF2); border-top-color: var(--c-primary, #2B6CB0); border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }

.main-trans { font-size: 38rpx; line-height: 1.6; color: var(--c-text, #1A1D24); margin-bottom: 24rpx; }
.meta { display: flex; align-items: center; gap: 16rpx; margin-bottom: 20rpx; }
.pos { background: var(--c-primary-weak, #EAF1FA); color: var(--c-primary, #2B6CB0); font-size: 24rpx; padding: 4rpx 14rpx; border-radius: 8rpx; }
.phon { color: var(--c-text-hint, #8A8F99); font-size: 28rpx; }
.senses { margin-bottom: 24rpx; }
.sense { font-size: 28rpx; color: var(--c-text-sub, #4B5563); line-height: 1.8; }
.sense::before { content: '· '; color: var(--c-primary, #2B6CB0); }
.example { background: var(--c-sunken, #FAFBFC); border-radius: 12rpx; padding: 20rpx 24rpx; }
.ex-en { font-size: 28rpx; line-height: 1.7; color: var(--c-text, #1A1D24); }
.ex-cn { font-size: 26rpx; line-height: 1.7; color: var(--c-text-hint, #8A8F99); margin-top: 8rpx; }

.sec-title { font-size: 28rpx; font-weight: 500; color: var(--c-text, #1A1D24); margin: 30rpx 0 16rpx; }
.structure { font-size: 28rpx; line-height: 1.8; color: var(--c-text-sub, #4B5563); }
.clause { background: var(--c-sunken, #FAFBFC); border-radius: 12rpx; padding: 18rpx 22rpx; margin-bottom: 16rpx; }
.clause.has-spk { position: relative; padding-right: 76rpx; }
.spk {
  position: absolute; right: 10rpx; top: 10rpx;
  font-size: 30rpx; line-height: 1;
  padding: 12rpx;
}
.clause-text { font-size: 28rpx; color: var(--c-primary, #2B6CB0); margin-bottom: 6rpx; }
.clause-type { display: inline-block; font-size: 22rpx; color: var(--c-tag-text, #B4690E); background: var(--c-tag-bg, #FBF3E4); border-radius: 6rpx; padding: 2rpx 12rpx; margin-bottom: 8rpx; }
.clause-explain { font-size: 26rpx; color: var(--c-text-sub, #4B5563); line-height: 1.7; }
.clause-explain.dim { color: var(--c-text-hint, #8A8F99); font-size: 24rpx; margin-top: 4rpx; }
.qa-answer {
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  background: var(--c-primary-quote, #F5F7FB);
  border-radius: 12rpx;
  font-size: 27rpx;
  color: var(--c-text, #1F2430);
  line-height: 1.8;
  word-break: break-all;
}
.qa-chips { display: flex; flex-wrap: wrap; gap: 14rpx; margin-bottom: 20rpx; }
.qa-chip {
  padding: 12rpx 22rpx;
  background: var(--c-primary-soft, #EBF2FC);
  color: var(--c-primary, #2B6CB0);
  font-size: 24rpx;
  border-radius: 28rpx;
  line-height: 1.4;
}

.badge { display: inline-block; background: var(--c-sunken, #FAFBFC); color: var(--c-text-hint, #8A8F99); font-size: 22rpx; padding: 6rpx 14rpx; border-radius: 8rpx; margin-bottom: 20rpx; }
.hint { color: var(--c-text-hint, #9AA0AA); font-size: 26rpx; text-align: center; padding: 40rpx 0; }

.note-input {
  width: 100%; height: 300rpx; box-sizing: border-box;
  background: var(--c-sunken, #FAFBFC); border-radius: 12rpx; padding: 20rpx;
  font-size: 28rpx; line-height: 1.7; color: var(--c-text, #1A1D24);
}
.note-ph { color: var(--c-text-faint, #C3C8D0); }
.note-save { margin-top: 24rpx; }

.foot {
  position: absolute; left: 0; right: 0; bottom: 0;
  display: flex; gap: 16rpx; padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: var(--c-card, #fff); border-top: 1rpx solid var(--c-border, #F0F1F4);
}
.foot-btn {
  flex: 1; text-align: center;
  border: 1rpx solid var(--c-primary, #2B6CB0); color: var(--c-primary, #2B6CB0);
  border-radius: var(--r-btn, 14rpx); font-size: 28rpx; padding: 16rpx 0;
}
.foot-btn.on { background: var(--c-primary, #2B6CB0); color: var(--c-on-primary, #fff); }

/* 面板里的英文内容（原文引用 / 例句 / 子句 / 音标）跟「阅读字体」走，
   界面元素（Tab、按钮、中文释义）用「界面字体」，中英混排各取所长 */
.sel-text, .ex-en, .clause-text, .phon { font-family: var(--font-read); }
