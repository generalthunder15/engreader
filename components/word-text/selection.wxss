.selection-bar {
  position: fixed;
  top: 0;
  left: 12px;
  width: calc(100vw - 24px);
  max-width: 480px;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  padding: 6px;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.14);
  z-index: 65;
}
.selection-hidden {
  visibility: hidden;
  pointer-events: none;
}
.selection-arrow {
  position: absolute;
  width: 12px;
  height: 12px;
  background: var(--card);
  transform: translateX(-50%) rotate(45deg);
}
.selection-bar.below .selection-arrow {
  top: -6px;
  border-top: 1rpx solid var(--line);
  border-left: 1rpx solid var(--line);
}
.selection-bar.above .selection-arrow {
  bottom: -6px;
  border-bottom: 1rpx solid var(--line);
  border-right: 1rpx solid var(--line);
}
.selection-actions {
  white-space: nowrap;
  width: 100%;
}
.selection-action {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 60px;
  height: 52px;
  vertical-align: top;
  gap: 8rpx;
  background: transparent;
  font-size: 12px;
  line-height: 1.4;
  padding: 6px 4px;
  font-weight: 400;
}
.selection-action-hover {
  background: var(--soft);
  border-radius: 12rpx;
}
.panel-tabs {
  flex: 1;
  min-width: 0;
  flex-wrap: nowrap;
  gap: 6rpx;
}
.panel-tabs .chip {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  min-width: 0;
  white-space: nowrap;
  min-height: 64rpx;
  line-height: 1.4;
  font-size: 22rpx;
  padding: 13rpx 0;
}
.analysis-sheet {
  padding-left: 25rpx;
  padding-right: 25rpx;
}
.analysis-sheet .sheet-head .icon-button {
  width: 64rpx;
  height: 64rpx;
  margin: 0 0 0 8rpx;
  padding: 0;
}
.definition {
  font-size: 34rpx;
  line-height: 1.8;
  margin: 25rpx 0 16rpx;
}
.panel-actions {
  margin: 30rpx 0;
}
.panel-actions button.small {
  width: auto;
  min-width: 0;
  flex: 1;
  margin: 0;
  padding: 15rpx 8rpx;
  white-space: nowrap;
}
