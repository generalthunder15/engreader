.dialog-layer { position: fixed; inset: 0; z-index: 1000; color: var(--text); }
.dialog-mask { position: absolute; inset: 0; background: rgba(10,24,18,.42); }
.dialog-card { position: absolute; top: 50%; left: 28rpx; right: 28rpx; transform: translateY(-50%); padding: 28rpx; border-radius: 32rpx; background: var(--card); box-shadow: 0 20rpx 80rpx rgba(0,0,0,.14); }
.dialog-menu { top: auto; bottom: calc(20rpx + env(safe-area-inset-bottom)); transform: none; }
.dialog-content { max-height: 44vh; white-space: pre-wrap; font-size: 28rpx; line-height: 1.8; margin-bottom: 24rpx; color: var(--muted); }
.dialog-actions { display: flex; gap: 20rpx; margin-top: 28rpx; }
.dialog-actions button { flex: 1; min-width: 0; margin: 0; }
.dialog-options { display: flex; flex-direction: column; gap: 16rpx; }
.dialog-options button { width: 100%; margin: 0; }
