<view class="exam" bindtap="readTap">
  <view class="title">{{title}}</view>
  <view class="muted">
    {{submitted ? '答案已提交' : '答案自动保存'}} · {{answered}} / {{total}} 题
  </view>
  <view wx:if="{{graded}}" class="result">
    答对 {{correct}} / {{total}} 题 · 请查看逐题反馈
  </view>
  <view wx:for="{{sections}}" wx:key="id" wx:for-item="section" class="section">
    <view class="section-title">{{section.title}}</view>
    <view wx:if="{{section.material}}" class="material"><reading-text text="{{section.material}}" indented="{{true}}" selection-key="{{section.id}}" active-key="{{selectionKey}}" bind:readtap="readTap" bind:selection="selectText" /></view>
    <view
      wx:for="{{section.questions}}"
      wx:key="id"
      wx:for-item="q"
      class="question"
    >
      <view wx:if="{{q.material}}" class="material"><reading-text text="{{q.material}}" indented="{{true}}" selection-key="{{q.id + '-material'}}" active-key="{{selectionKey}}" bind:readtap="readTap" bind:selection="selectText" /></view>
      <view class="question-title"><reading-text text="{{index + 1 + '. ' + q.title}}" selection-key="{{q.id}}" active-key="{{selectionKey}}" bind:readtap="readTap" bind:selection="selectText" /></view>
      <view wx:if="{{q.type === 'choice'}}" class="option-grid" data-id="{{q.id}}" style="grid-template-columns:repeat({{columns[q.id] || 1}}, minmax(0, 1fr))">
        <view
          wx:for="{{q.options}}"
          wx:key="index"
          wx:for-item="option"
          class="option {{answers[q.id] === (index === 0 ? 'A' : index === 1 ? 'B' : index === 2 ? 'C' : 'D') ? 'selected' : ''}}"
          aria-role="button"
          aria-disabled="{{submitted || busy}}"
          data-id="{{q.id}}"
          data-value="{{index === 0 ? 'A' : index === 1 ? 'B' : index === 2 ? 'C' : 'D'}}"
          catchtap="pick"
        >
          <reading-text text="{{option}}" data-id="{{q.id}}" data-value="{{index === 0 ? 'A' : index === 1 ? 'B' : index === 2 ? 'C' : 'D'}}" selection-key="{{q.id + '-' + index}}" active-key="{{selectionKey}}" bind:readtap="pick" bind:selection="selectText" />
        </view>
        <text wx:for="{{q.options}}" wx:key="index" class="option-measure" data-id="{{q.id}}" aria-hidden="true">{{item}}</text>
      </view>
      <textarea show-confirm-bar="{{false}}"
        wx:else
        class="answer"
        value="{{answers[q.id] || ''}}"
        data-id="{{q.id}}"
        bindinput="fill"
        catchtap="noop"
        disabled="{{submitted || busy}}"
        maxlength="5000"
        auto-height
        placeholder="{{submitted ? '未作答' : q.type === 'translation' ? '在这里写下你的翻译…' : '在这里填写答案…'}}"
      />
      <view
        wx:if="{{grades[q.id]}}"
        class="feedback {{grades[q.id].correct ? 'right' : 'wrong'}}"
      >
        <view>{{grades[q.id].correct ? '✓ 回答正确' : '需要巩固'}}</view>
        <text user-select>{{grades[q.id].feedback}}</text>
        <view class="reference">参考答案：{{q.answer}}</view>
        <view>{{q.explanation}}</view>
      </view>
    </view>
  </view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <view class="exam-actions">
    <button class="submit {{submitted ? 'submitted' : ''}}" catchtap="submit" disabled="{{submitted || busy}}">{{submitted ? '已提交' : '提交试卷'}}</button>
    <button class="return" catchtap="study">返回对话</button>
  </view>
  <view wx:if="{{submitted && !graded}}" class="grading-status">
    <text>{{busy ? '正在批改，请稍候…' : '答卷已锁定，批改尚未完成。'}}</text>
    <button wx:if="{{!busy}}" class="retry" catchtap="submit">重试批改</button>
  </view>
</view>
